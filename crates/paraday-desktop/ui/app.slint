// Version: V1.0
// Description: Multi-channel concurrent time-tracking & man-day billing engine.

import { LineEdit, ScrollView } from "std-widgets.slint";

export struct ProjectItem {
    id: string,
    name: string,
    client: string,
    rate-info: string,
    timer-text: string,
    days-text: string,
    amount-text: string,
    is-running: bool,
    is-paused: bool,
}

export struct EntryItem {
    id: string,
    project-name: string,
    duration-text: string,
    days-text: string,
    amount-text: string,
    summary-text: string,
    time-range: string,
    has-audio: bool,
    audio-path: string,
}

export struct NoteItem {
    id: string,
    project-name: string,
    time-text: string,
    content: string,
}

export struct AfkItem {
    id: string,
    project-name: string,
    elapsed-text: string,
    is-deduct: bool,
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #6366f1;
    in property <color> hover-color: #4f46e5;
    in property <color> text-color: #ffffff;
    in property <length> custom-height: 34px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 8px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.text-color;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <color> border-col: #30363d;
    in property <color> text-color: #c9d1d9;
    in property <length> custom-height: 30px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? #8b949e : border-col;
    background: touch.pressed ? #21262d : (touch.has-hover ? #21262d : transparent);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: touch.has-hover ? #ffffff : root.text-color;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component MiniButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #238636;
    in property <color> hover-color: #2ea043;
    in property <color> text-color: #ffffff;
    callback clicked <=> touch.clicked;

    height: 28px;
    border-radius: 6px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: root.text-color;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component ChipButton inherits Rectangle {
    in property <string> text;
    callback clicked <=> touch.clicked;

    height: 26px;
    border-radius: 6px;
    background: touch.pressed ? #30363d : (touch.has-hover ? #21262d : #161b22);
    border-width: 1px;
    border-color: touch.has-hover ? #58a6ff : #30363d;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 500;
            color: touch.has-hover ? #ffffff : #c9d1d9;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component SidebarTabItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> title: "";
    in property <bool> active: false;
    in property <bool> has-indicator: false;
    callback clicked <=> touch.clicked;

    height: 38px;
    border-radius: 8px;
    background: active ? #21262d : (touch.has-hover ? #161b22 : transparent);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: root.icon;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: root.active ? 700 : 500;
                color: root.active ? #ffffff : (touch.has-hover ? #f0f6fc : #8b949e);
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        if root.has-indicator : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #3fb950;
            y: (parent.height - self.height) / 2;
        }
    }
}

component DarkInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <length> custom-height: 36px;
    in property <color> input-bg: #0d1117;
    in property <color> border-col: #30363d;
    in property <color> focus-border-col: #6366f1;
    callback accepted();
    callback edited(string);

    height: custom-height;
    background: input-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? focus-border-col : border-col;

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        color: #f0f6fc;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: #6e7681;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component MainWindow inherits Window {
    title: "ParaDay - Multi-Channel Time Tracker v1.0";
    icon: @image-url("icon.png");
    min-width: 900px;
    min-height: 620px;
    preferred-width: 960px;
    preferred-height: 680px;
    background: #090d16;

    // 0: 控制台, 1: 交付对账, 2: 闪念便签, 3: 设置中心
    in-out property <int> active-tab: 0;

    // 独立模态浮层控制
    in-out property <bool> show-meeting-modal: false;
    in-out property <bool> show-new-project-modal: false;
    in-out property <bool> show-afk-modal: false;
    in-out property <bool> show-detail-modal: false;

    // 会议纪要与录音文稿详情字段
    in-out property <string> detail-entry-id: "";
    in-out property <string> detail-project-name: "";
    in-out property <string> detail-time-range: "";
    in-out property <string> detail-duration: "";
    in-out property <string> detail-days: "";
    in-out property <string> detail-amount: "";
    in-out property <string> detail-summary: "";
    in-out property <string> detail-transcript: "";
    in-out property <string> detail-audio-path: "";
    in-out property <bool> detail-has-audio: false;

    in property <string> total-days: "0.00";
    in property <string> total-amount: "¥ 0.00";
    in property <int> running-count: 0;
    in-out property <string> note-input: "";
    in-out property <string> toast-message: "";

    // 新建项目表单字段
    in-out property <string> new-proj-name: "";
    in-out property <string> new-proj-client: "";
    in-out property <string> new-proj-rate: "3000";
    in-out property <string> new-proj-currency: "CNY";
    in-out property <string> new-proj-git: "";

    // 快速会议与讨论字段
    in-out property <int> meeting-selected-proj-idx: -1;
    in-out property <string> meeting-selected-proj-name: "独立临时会议";
    in-out property <string> meeting-selected-proj-client: "临时立项";
    in-out property <string> meeting-selected-proj-rate: "350 CNY / 小时";
    in-out property <string> meeting-topic-input: "";
    in-out property <string> meeting-rate-input: "350";
    in-out property <bool> meeting-record-audio: true;

    // 麦克风录音与声波状态
    in property <bool> is-recording-audio: false;
    in property <bool> is-audio-paused: false;
    in property <string> audio-timer-text: "00:00:00";
    in property <float> audio-volume-level: 0.0;
    in property <string> active-recording-project-name: "";
    in property <string> playing-audio-path: "";

    // 设置中心字段
    in-out property <string> setting-ai-base: "https://api.deepseek.com/v1";
    in-out property <string> setting-ai-key: "";
    in-out property <string> setting-ai-model: "deepseek-chat";
    in-out property <string> setting-hours-per-day: "8.0";
    in-out property <string> setting-afk-minutes: "10";

    // AFK 校准数据
    in-out property <string> afk-away-minutes: "30";
    in property <[AfkItem]> afk-items: [];

    in property <[ProjectItem]> projects: [];
    in property <[EntryItem]> recent-entries: [];
    in property <[NoteItem]> note-items: [];

    callback start-project(string /* project-id */);
    callback pause-project(string /* project-id */);
    callback resume-project(string /* project-id */);
    callback stop-project(string /* project-id */);
    callback delete-project(string /* project-id */);
    callback add-quick-note(string /* note-content */);
    callback delete-quick-note(string /* note-id */);
    callback submit-new-project();
    callback start-quick-meeting(int /* proj-idx */, string /* topic */, string /* rate */, bool /* record-audio */);
    callback select-meeting-project(int /* proj-idx */);
    callback open-meeting-modal();
    callback toggle-audio-pause();
    callback stop-audio-recording();
    callback play-entry-audio(string /* audio-path */);
    callback stop-audio-playback();
    callback open-entry-folder(string /* audio-path */);
    callback transcribe-entry-audio(string /* entry-id */, string /* audio-path */);
    callback save-settings();
    callback test-ai-connection();
    callback trigger-ai-summarize();
    callback copy-markdown();
    callback open-afk-modal();
    callback apply-afk-resolution(bool /* deduct-all */);
    callback open-entry-detail(string /* entry-id */);
    callback copy-text-to-clipboard(string /* text */);

    // ==================== 主工作区水平双栏布局 ====================
    HorizontalLayout {
        // ----------------- 左侧导航边栏 (230px 宽) -----------------
        Rectangle {
            width: 230px;
            background: #090d16;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: space-between;

                // 边栏上半部分
                VerticalLayout {
                    spacing: 16px;

                    // 品牌区
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #6366f1;
                            Text {
                                text: "P";
                                font-size: 16px;
                                font-weight: 900;
                                color: #ffffff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "ParaDay";
                                font-size: 16px;
                                font-weight: 800;
                                color: #f0f6fc;
                            }
                            Text {
                                text: "平行人天 · 研发计费";
                                font-size: 11px;
                                color: #8b949e;
                            }
                        }
                    }

                    // 核心主动作：发起会议沟通 (全宽单行，永远不折行)
                    PrimaryButton {
                        text: "🎙️ 发起会议沟通";
                        bg-color: #6366f1;
                        hover-color: #4f46e5;
                        custom-height: 38px;
                        clicked => {
                            root.open-meeting-modal();
                        }
                    }

                    // 导航菜单列表
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-bottom: 4px;
                            Text {
                                text: "主菜单";
                                font-size: 11px;
                                font-weight: 700;
                                color: #6e7681;
                            }
                        }

                        SidebarTabItem {
                            icon: "⏱️";
                            title: "计时控制台";
                            active: root.active-tab == 0;
                            has-indicator: root.running-count > 0;
                            clicked => { root.active-tab = 0; }
                        }

                        SidebarTabItem {
                            icon: "📊";
                            title: "交付对账单";
                            active: root.active-tab == 1;
                            clicked => { root.active-tab = 1; }
                        }

                        SidebarTabItem {
                            icon: "📝";
                            title: "闪念便签库";
                            active: root.active-tab == 2;
                            clicked => { root.active-tab = 2; }
                        }

                        SidebarTabItem {
                            icon: "⚙️";
                            title: "系统与AI设置";
                            active: root.active-tab == 3;
                            clicked => { root.active-tab = 3; }
                        }
                    }
                }

                // 边栏底部：今日财务与工时统计
                Rectangle {
                    background: #161b22;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #21262d;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: "今日累计交付";
                            font-size: 11px;
                            color: #8b949e;
                        }

                        Text {
                            text: root.total-amount;
                            font-size: 18px;
                            font-weight: 900;
                            color: #3fb950;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "折算工时:";
                                font-size: 11px;
                                color: #8b949e;
                            }
                            Text {
                                text: root.total-days + " 人天";
                                font-size: 11px;
                                font-weight: 700;
                                color: #f0f6fc;
                            }
                        }
                    }
                }
            }
        }

        // 垂直分割线
        Rectangle {
            width: 1px;
            background: #21262d;
        }

        // ----------------- 右侧主工作区画布 -----------------
        Rectangle {
            background: #0d1117;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // 顶部 Header (标题 + 动作按钮)
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.active-tab == 0 ? "进行中的研发工时" : (root.active-tab == 1 ? "交付工时与流水对账" : (root.active-tab == 2 ? "闪念便签与沟通备忘" : "系统配置与AI模型"));
                            font-size: 18px;
                            font-weight: 800;
                            color: #f0f6fc;
                        }
                        Text {
                            text: root.active-tab == 0 ? "多通道并行计量 · 容灾秒级时钟 · 商业录音凭证" : (root.active-tab == 1 ? "按半天(0.5人天)阶梯封顶核算 · AI一键生成总结纪要" : (root.active-tab == 2 ? "随手记录需求变更与客户沟通" : "配置 OpenAI/DeepSeek 密钥与 AFK 离开阈值"));
                            font-size: 11px;
                            color: #8b949e;
                        }
                    }

                    // 右侧动作按钮区 (单行横排，按钮文字绝不换行！)
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        // 状态徽标
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: root.running-count > 0 ? #0f2417 : #161b22;
                            border-width: 1px;
                            border-color: root.running-count > 0 ? #238636 : #30363d;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.running-count > 0 ? #3fb950 : #6e7681;
                                }
                                Text {
                                    text: root.running-count > 0 ? (root.running-count + " 个通道计时中") : "无活动通道";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.running-count > 0 ? #3fb950 : #8b949e;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // 新建项目按钮 (单行水平)
                        OutlineButton {
                            text: "➕ 新建项目";
                            custom-height: 28px;
                            clicked => {
                                root.show-new-project-modal = true;
                            }
                        }

                        // AFK校准按钮 (单行水平)
                        OutlineButton {
                            text: "⚡ AFK校准";
                            custom-height: 28px;
                            clicked => {
                                root.open-afk-modal();
                            }
                        }
                    }
                }

                // 录音状态微幅横幅 (录音时显示)
                if root.is-recording-audio : Rectangle {
                    height: 40px;
                    background: #1e1338;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #8b5cf6;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #a855f7;
                            }
                            Text {
                                text: "🎙️ 会议录音中: " + root.active-recording-project-name + " · " + root.audio-timer-text;
                                font-size: 12px;
                                font-weight: 700;
                                color: #ede9fe;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            MiniButton {
                                text: root.is-audio-paused ? "▶ 继续录音" : "⏸ 暂停录音";
                                bg-color: #d97706;
                                hover-color: #b45309;
                                clicked => { root.toggle-audio-pause(); }
                            }
                            MiniButton {
                                text: "⏹ 结束录音";
                                bg-color: #dc2626;
                                hover-color: #b91c1c;
                                clicked => { root.stop-audio-recording(); }
                            }
                        }
                    }
                }

                // ================= Tab 0: 计时控制台 =================
                if root.active-tab == 0 : VerticalLayout {
                    spacing: 12px;

                    // 项目列表卡片
                    ScrollView {
                        height: 450px;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;

                            if root.projects.length == 0 : Rectangle {
                                height: 120px;
                                background: #161b22;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #21262d;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "暂无进行中的项目，点击右上角【➕ 新建项目】或左侧【🎙️ 发起会议】开启计时";
                                        font-size: 13px;
                                        color: #6e7681;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            for item in root.projects : Rectangle {
                                height: 76px;
                                background: item.is-running ? #161b22 : #11161f;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: item.is-running ? #238636 : #21262d;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    // 左侧信息
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 14px;

                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 10px;
                                            background: item.is-running ? #0f2417 : #1c2128;
                                            border-width: 1px;
                                            border-color: item.is-running ? #238636 : #30363d;
                                            Text {
                                                text: "📁";
                                                font-size: 18px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Text {
                                                    text: item.name;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    color: #f0f6fc;
                                                }
                                                Rectangle {
                                                    height: 18px;
                                                    border-radius: 4px;
                                                    background: #21262d;
                                                    HorizontalLayout {
                                                        padding-left: 6px; padding-right: 6px;
                                                        Text {
                                                            text: item.client;
                                                            font-size: 10px;
                                                            font-weight: 600;
                                                            color: #8b949e;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                if item.is-running : Rectangle {
                                                    height: 18px;
                                                    border-radius: 4px;
                                                    background: #0f2417;
                                                    border-width: 1px;
                                                    border-color: #238636;
                                                    HorizontalLayout {
                                                        padding-left: 6px; padding-right: 6px;
                                                        Text {
                                                            text: "计时中";
                                                            font-size: 10px;
                                                            font-weight: 700;
                                                            color: #3fb950;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: "标准: " + item.rate-info;
                                                    font-size: 11px;
                                                    color: #8b949e;
                                                }
                                                Text { text: "•"; font-size: 11px; color: #484f58; }
                                                Text {
                                                    text: "今日累计: " + item.amount-text;
                                                    font-size: 11px;
                                                    color: #8b949e;
                                                }
                                            }
                                        }
                                    }

                                    // 右侧时钟与按钮
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 16px;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: item.timer-text;
                                                font-size: 24px;
                                                font-weight: 900;
                                                font-family: "monospace";
                                                color: item.is-running ? #3fb950 : #8b949e;
                                                horizontal-alignment: right;
                                            }
                                            Text {
                                                text: item.days-text;
                                                font-size: 11px;
                                                color: #8b949e;
                                                horizontal-alignment: right;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            if !item.is-running && !item.is-paused : MiniButton {
                                                text: "▶ 启动计时";
                                                bg-color: #238636;
                                                hover-color: #2ea043;
                                                clicked => { root.start-project(item.id); }
                                            }
                                            if item.is-running : HorizontalLayout {
                                                spacing: 6px;
                                                MiniButton {
                                                    text: "⏸ 暂停";
                                                    bg-color: #d29922;
                                                    hover-color: #bb8009;
                                                    clicked => { root.pause-project(item.id); }
                                                }
                                                MiniButton {
                                                    text: "⏹ 结算";
                                                    bg-color: #da3633;
                                                    hover-color: #b62324;
                                                    clicked => { root.stop-project(item.id); }
                                                }
                                            }
                                            if item.is-paused : HorizontalLayout {
                                                spacing: 6px;
                                                MiniButton {
                                                    text: "▶ 继续";
                                                    bg-color: #238636;
                                                    hover-color: #2ea043;
                                                    clicked => { root.resume-project(item.id); }
                                                }
                                                MiniButton {
                                                    text: "⏹ 结算";
                                                    bg-color: #da3633;
                                                    hover-color: #b62324;
                                                    clicked => { root.stop-project(item.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 底部闪念便签栏
                    Rectangle {
                        height: 44px;
                        background: #161b22;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #21262d;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;
                            DarkInput {
                                custom-height: 32px;
                                placeholder: "闪念便签：记录电话/讨论（敲回车自动存入便签库）...";
                                text <=> root.note-input;
                                accepted => {
                                    if (root.note-input != "") {
                                        root.add-quick-note(root.note-input);
                                        root.note-input = "";
                                    }
                                }
                            }
                            PrimaryButton {
                                text: "存便签";
                                bg-color: #21262d;
                                hover-color: #30363d;
                                text-color: #c9d1d9;
                                custom-height: 32px;
                                clicked => {
                                    if (root.note-input != "") {
                                        root.add-quick-note(root.note-input);
                                        root.note-input = "";
                                    }
                                }
                            }
                        }
                    }
                }

                // ================= Tab 1: 交付对账单 =================
                if root.active-tab == 1 : VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #161b22;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #21262d;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "今日交付工时与流水明细"; font-size: 14px; font-weight: 700; color: #f0f6fc; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PrimaryButton {
                                        text: "✨ AI提炼总结";
                                        bg-color: #6366f1;
                                        hover-color: #4f46e5;
                                        custom-height: 30px;
                                        clicked => { root.trigger-ai-summarize(); }
                                    }
                                    OutlineButton {
                                        text: "📋 复制对账单";
                                        custom-height: 30px;
                                        clicked => { root.copy-markdown(); }
                                    }
                                }
                            }

                            ScrollView {
                                height: 430px;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 8px;
                                    if root.recent-entries.length == 0 : Text {
                                        text: "今日尚无已归档结算记录。在控制台点击【⏹ 结算】后自动生成。";
                                        font-size: 12px;
                                        color: #6e7681;
                                    }
                                    for e in root.recent-entries : Rectangle {
                                        background: #0d1117;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #21262d;

                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: e.project-name; font-size: 13px; font-weight: 700; color: #58a6ff; }
                                                Text { text: e.time-range; font-size: 11px; color: #6e7681; }
                                            }
                                            Text { text: e.summary-text; font-size: 12px; color: #c9d1d9; }
                                            HorizontalLayout {
                                                spacing: 16px;
                                                Text { text: "工时: " + e.duration-text; font-size: 11px; color: #8b949e; }
                                                Text { text: "折算: " + e.days-text; font-size: 11px; font-weight: 700; color: #d29922; }
                                                Text { text: "金额: " + e.amount-text; font-size: 11px; font-weight: 700; color: #3fb950; }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: space-between;

                                                if e.has-audio : HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    Rectangle {
                                                        height: 24px;
                                                        background: #1e1338;
                                                        border-radius: 4px;
                                                        border-width: 1px;
                                                        border-color: #6366f1;
                                                        HorizontalLayout {
                                                            padding-left: 8px; padding-right: 8px;
                                                            Text { text: "🎙️ 录音凭证"; font-size: 11px; font-weight: 700; color: #c4b5fd; vertical-alignment: center; }
                                                        }
                                                    }
                                                    MiniButton {
                                                        text: root.playing-audio-path == e.audio-path ? "⏹ 停止" : "▶ 播放";
                                                        bg-color: root.playing-audio-path == e.audio-path ? #da3633 : #6366f1;
                                                        hover-color: root.playing-audio-path == e.audio-path ? #b62324 : #4f46e5;
                                                        clicked => {
                                                            if (root.playing-audio-path == e.audio-path) {
                                                                root.stop-audio-playback();
                                                            } else {
                                                                root.play-entry-audio(e.audio-path);
                                                            }
                                                        }
                                                    }
                                                    OutlineButton {
                                                        text: "📂 目录";
                                                        custom-height: 24px;
                                                        clicked => { root.open-entry-folder(e.audio-path); }
                                                    }
                                                    MiniButton {
                                                        text: "🤖 转写";
                                                        bg-color: #238636;
                                                        hover-color: #2ea043;
                                                        clicked => { root.transcribe-entry-audio(e.id, e.audio-path); }
                                                    }
                                                }

                                                OutlineButton {
                                                    text: "📄 查看纪要与文稿";
                                                    custom-height: 24px;
                                                    clicked => { root.open-entry-detail(e.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ================= Tab 2: 闪念便签历史 =================
                if root.active-tab == 2 : VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #161b22;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #21262d;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text { text: "今日登记的闪念便签与电话记录"; font-size: 14px; font-weight: 700; color: #f0f6fc; }

                            ScrollView {
                                height: 430px;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 8px;
                                    if root.note-items.length == 0 : Text {
                                        text: "今日暂无便签记录。可在控制台输入框随手登记需求与电话讨论。";
                                        font-size: 12px;
                                        color: #6e7681;
                                    }
                                    for n in root.note-items : Rectangle {
                                        background: #0d1117;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #21262d;

                                        HorizontalLayout {
                                            padding: 12px;
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: n.time-text; font-size: 11px; color: #58a6ff; }
                                                    Text { text: "[" + n.project-name + "]"; font-size: 11px; color: #8b949e; }
                                                }
                                                Text { text: n.content; font-size: 13px; color: #f0f6fc; }
                                            }
                                            MiniButton {
                                                text: "删除";
                                                bg-color: #21262d;
                                                hover-color: #da3633;
                                                clicked => { root.delete-quick-note(n.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ================= Tab 3: 系统与 AI 设置 =================
                if root.active-tab == 3 : VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #161b22;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #21262d;

                        ScrollView {
                            height: 460px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                Text { text: "AI 大模型服务商设置 (用于工作总结与会议纪要提炼)"; font-size: 14px; font-weight: 700; color: #58a6ff; }

                                Text { text: "API Base URL (兼容 OpenAI / DeepSeek / Ollama)"; font-size: 12px; color: #8b949e; }
                                DarkInput { text <=> root.setting-ai-base; }

                                Text { text: "API Key (密钥)"; font-size: 12px; color: #8b949e; }
                                DarkInput { text <=> root.setting-ai-key; placeholder: "sk-xxxxxxxxxxxx (可留空或填入本地 Ollama)"; }

                                Text { text: "模型名称 (Model)"; font-size: 12px; color: #8b949e; }
                                DarkInput { text <=> root.setting-ai-model; placeholder: "deepseek-chat"; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    OutlineButton {
                                        text: "🧪 测试 AI 连接";
                                        border-col: #58a6ff;
                                        text-color: #58a6ff;
                                        custom-height: 32px;
                                        clicked => { root.test-ai-connection(); }
                                    }
                                }

                                Rectangle { height: 1px; background: #21262d; }

                                Text { text: "工时与防遗漏守护规则"; font-size: 14px; font-weight: 700; color: #58a6ff; }

                                HorizontalLayout {
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "每日基准工时 (小时/人天)"; font-size: 12px; color: #8b949e; }
                                        DarkInput { text <=> root.setting-hours-per-day; }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "AFK 空闲离开阈值 (分钟)"; font-size: 12px; color: #8b949e; }
                                        DarkInput { text <=> root.setting-afk-minutes; }
                                    }
                                }

                                PrimaryButton {
                                    text: "💾 保存全部系统设置";
                                    bg-color: #238636;
                                    hover-color: #2ea043;
                                    custom-height: 36px;
                                    clicked => { root.save-settings(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== 底部 Toast 提示 (无弹窗时显示，绝不遮挡弹窗) ====================
    if root.toast-message != "" && !root.show-meeting-modal && !root.show-new-project-modal && !root.show-afk-modal && !root.show-detail-modal : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 48px;
        height: 36px;
        background: #0f2417;
        border-radius: 18px;
        border-width: 1px;
        border-color: #238636;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;
            Text { text: root.toast-message; font-size: 12px; font-weight: 600; color: #3fb950; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toast-message = ""; }
                Text { text: "✕"; font-size: 11px; color: #8b949e; vertical-alignment: center; }
            }
        }
    }

    // ==================== 独立居中 Modal 1: 发起会议弹窗 ====================
    if root.show-meeting-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000ca;

        // 点击半透明遮罩背景即可快速关闭弹窗
        TouchArea {
            clicked => { root.show-meeting-modal = false; }
        }

        // 居中卡片本体 (固定高度与布局，Header/Footer 永不裁切)
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 530px;
            height: 450px;
            background: #161b22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #30363d;

            // 拦截卡片内部点击，防止误触发背景关闭
            TouchArea {}

            VerticalLayout {
                // 1. 顶部 Header (固定 46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #6366f1;
                            Text {
                                text: "🎙️";
                                font-size: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "发起即时会议与讨论"; font-size: 15px; font-weight: 800; color: #f0f6fc; }
                            Text { text: "独立计时通道 · 录音直写本地 · 自动提炼AI纪要"; font-size: 11px; color: #8b949e; }
                        }
                    }

                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-meeting-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #30363d : #21262d;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #8b949e;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 顶部分割线
                Rectangle { height: 1px; background: #21262d; }

                // 2. 表单核心内容区
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    // 关联客户项目
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "关联客户项目"; font-size: 12px; font-weight: 700; color: #c9d1d9; }
                        Text { text: "临时会议单独立项，不计入既有项目"; font-size: 11px; color: #6e7681; }
                    }

                    ScrollView {
                        height: 80px;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 5px;

                            // 临时会议
                            Rectangle {
                                height: 32px;
                                background: root.meeting-selected-proj-idx == -1 ? #1f242c : #0d1117;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.meeting-selected-proj-idx == -1 ? #6366f1 : #21262d;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-meeting-project(-1); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "⚡ 独立临时会议 (单独立项 · 不计入客户)";
                                        font-size: 12px;
                                        font-weight: root.meeting-selected-proj-idx == -1 ? 700 : 500;
                                        color: root.meeting-selected-proj-idx == -1 ? #ffffff : #c9d1d9;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.meeting-selected-proj-idx == -1 ? "✓ 已选" : "选择";
                                        font-size: 11px;
                                        color: root.meeting-selected-proj-idx == -1 ? #818cf8 : #6e7681;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 客户项目列表
                            for p[idx] in root.projects : Rectangle {
                                height: 32px;
                                background: root.meeting-selected-proj-idx == idx ? #1f242c : #0d1117;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.meeting-selected-proj-idx == idx ? #6366f1 : #21262d;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-meeting-project(idx); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Text {
                                            text: "📁 " + p.name;
                                            font-size: 12px;
                                            font-weight: root.meeting-selected-proj-idx == idx ? 700 : 500;
                                            color: root.meeting-selected-proj-idx == idx ? #ffffff : #c9d1d9;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "[" + p.client + "]";
                                            font-size: 10px;
                                            color: #6e7681;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.meeting-selected-proj-idx == idx ? "✓ 已选" : "选择";
                                        font-size: 11px;
                                        color: root.meeting-selected-proj-idx == idx ? #818cf8 : #6e7681;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 议题
                    Text { text: "会议/讨论议题"; font-size: 12px; font-weight: 700; color: #c9d1d9; }
                    DarkInput {
                        custom-height: 32px;
                        placeholder: "例如：商业客户需求沟通与技术方案评审";
                        text <=> root.meeting-topic-input;
                    }

                    // 快速标签 Chips
                    HorizontalLayout {
                        spacing: 6px;
                        ChipButton {
                            text: "架构方案评审";
                            clicked => { root.meeting-topic-input = "技术架构方案与接口评审会"; }
                        }
                        ChipButton {
                            text: "客户需求对接";
                            clicked => { root.meeting-topic-input = "商业客户需求与排期沟通会"; }
                        }
                        ChipButton {
                            text: "敏捷迭代站会";
                            clicked => { root.meeting-topic-input = "项目日常敏捷对齐与进度同步"; }
                        }
                        ChipButton {
                            text: "紧急故障排查";
                            clicked => { root.meeting-topic-input = "线上紧急故障排查与复盘分析"; }
                        }
                    }

                    // 录音开关
                    Rectangle {
                        height: 38px;
                        background: #0d1117;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.meeting-record-audio ? #6366f1 : #21262d;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.meeting-record-audio = !root.meeting-record-audio; }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "🎙️"; font-size: 14px; vertical-alignment: center; }
                                Text { text: "同步开启麦克风无损录音 (驱动 AI 纪要)"; font-size: 12px; font-weight: 600; color: #f0f6fc; vertical-alignment: center; }
                            }
                            Text {
                                text: root.meeting-record-audio ? "● 录音开启中" : "○ 已关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.meeting-record-audio ? #3fb950 : #6e7681;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 底部分割线
                Rectangle { height: 1px; background: #21262d; }

                // 3. 底部操作栏 (固定 48px，永远绝不裁切)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "取消";
                        custom-height: 32px;
                        clicked => { root.show-meeting-modal = false; }
                    }
                    PrimaryButton {
                        text: root.meeting-record-audio ? "🎙️ 启动会议计时并录音" : "▶ 启动会议计时";
                        bg-color: #6366f1;
                        hover-color: #4f46e5;
                        custom-height: 32px;
                        clicked => {
                            root.start-quick-meeting(root.meeting-selected-proj-idx, root.meeting-topic-input, root.meeting-rate-input, root.meeting-record-audio);
                        }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 2: 新建项目弹窗 ====================
    if root.show-new-project-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000ca;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-new-project-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 490px;
            height: 390px;
            background: #161b22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #30363d;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text { text: "➕ 创建新的商业项目"; font-size: 15px; font-weight: 800; color: #f0f6fc; vertical-alignment: center; }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-new-project-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #30363d : #21262d;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #8b949e;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // Form Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;

                    Text { text: "项目名称 (必填)"; font-size: 11px; color: #8b949e; }
                    DarkInput { custom-height: 30px; placeholder: "例如：客户A 跨境商城二次重构"; text <=> root.new-proj-name; }

                    Text { text: "客户/组织名称"; font-size: 11px; color: #8b949e; }
                    DarkInput { custom-height: 30px; placeholder: "例如：张总 / 某某科技有限公司"; text <=> root.new-proj-client; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "人天单价 (元/天)"; font-size: 11px; color: #8b949e; }
                            DarkInput { custom-height: 30px; placeholder: "3000"; text <=> root.new-proj-rate; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "结算币种"; font-size: 11px; color: #8b949e; }
                            DarkInput { custom-height: 30px; placeholder: "CNY"; text <=> root.new-proj-currency; }
                        }
                    }

                    Text { text: "本地 Git 仓库路径 (可选)"; font-size: 11px; color: #8b949e; }
                    DarkInput { custom-height: 30px; placeholder: "/home/beatle/dev/my-project"; text <=> root.new-proj-git; }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "取消";
                        custom-height: 32px;
                        clicked => { root.show-new-project-modal = false; }
                    }
                    PrimaryButton {
                        text: "➕ 保存并创建项目";
                        bg-color: #238636;
                        hover-color: #2ea043;
                        custom-height: 32px;
                        clicked => { root.submit-new-project(); }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 3: AFK校准弹窗 ====================
    if root.show-afk-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000ca;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-afk-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 490px;
            height: 380px;
            background: #161b22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #30363d;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text { text: "⚡ AFK 离开工时校准"; font-size: 15px; font-weight: 800; color: #f0f6fc; vertical-alignment: center; }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-afk-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #30363d : #21262d;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #8b949e;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // Content Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    Text {
                        text: "检测到您离开键盘超过设定阈值。系统已自动保护并发计时通道，请确认是否扣除离开工时：";
                        font-size: 12px;
                        color: #8b949e;
                    }

                    ScrollView {
                        height: 150px;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 6px;
                            for a in root.afk-items : Rectangle {
                                height: 42px;
                                background: #0d1117;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #21262d;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: a.project-name; font-size: 12px; font-weight: 700; color: #f0f6fc; }
                                        Text { text: "当前累计: " + a.elapsed-text; font-size: 11px; color: #8b949e; }
                                    }
                                    Text { text: "建议扣除"; font-size: 11px; color: #d29922; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "全部保留有效投入";
                        custom-height: 32px;
                        clicked => { root.apply-afk-resolution(false); }
                    }
                    PrimaryButton {
                        text: "全部扣除离开时间";
                        bg-color: #d29922;
                        hover-color: #bb8009;
                        custom-height: 32px;
                        clicked => { root.apply-afk-resolution(true); }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 4: 会议纪要与转写文稿详情弹窗 ====================
    if root.show-detail-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000ca;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-detail-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 580px;
            height: 520px;
            background: #161b22;
            border-radius: 14px;
            border-width: 1px;
            border-color: #30363d;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // 1. Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #6366f1;
                            Text {
                                text: "📄";
                                font-size: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "会议纪要与录音凭证详情"; font-size: 15px; font-weight: 800; color: #f0f6fc; }
                            Text { text: root.detail-project-name + " · " + root.detail-time-range + " (" + root.detail-duration + " · " + root.detail-amount + ")"; font-size: 11px; color: #8b949e; }
                        }
                    }

                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-detail-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #30363d : #21262d;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #8b949e;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // 2. Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;

                    // 音频操作横条 (如果有录音)
                    if root.detail-has-audio : Rectangle {
                        height: 38px;
                        background: #0d1117;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #30363d;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "🎙️ 会议录音"; font-size: 12px; font-weight: 700; color: #c4b5fd; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                MiniButton {
                                    text: root.playing-audio-path == root.detail-audio-path ? "⏹ 停止播放" : "▶ 播放录音";
                                    bg-color: root.playing-audio-path == root.detail-audio-path ? #da3633 : #6366f1;
                                    hover-color: root.playing-audio-path == root.detail-audio-path ? #b62324 : #4f46e5;
                                    clicked => {
                                        if (root.playing-audio-path == root.detail-audio-path) {
                                            root.stop-audio-playback();
                                        } else {
                                            root.play-entry-audio(root.detail-audio-path);
                                        }
                                    }
                                }
                                OutlineButton {
                                    text: "📂 录音目录";
                                    custom-height: 24px;
                                    clicked => { root.open-entry-folder(root.detail-audio-path); }
                                }
                                MiniButton {
                                    text: "🤖 AI语音转写";
                                    bg-color: #238636;
                                    hover-color: #2ea043;
                                    clicked => { root.transcribe-entry-audio(root.detail-entry-id, root.detail-audio-path); }
                                }
                            }
                        }
                    }

                    // 模块 1: AI 会议纪要与交付提炼
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "✨ AI 会议纪要与交付决策"; font-size: 12px; font-weight: 700; color: #58a6ff; }
                        }
                        Rectangle {
                            height: 140px;
                            background: #0d1117;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #21262d;
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.detail-summary;
                                        font-size: 12px;
                                        color: #f0f6fc;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // 模块 2: 录音转写文稿 (Whisper 逐字稿)
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "📝 录音转写全文文稿 (Whisper Transcript)"; font-size: 12px; font-weight: 700; color: #58a6ff; }
                            if root.detail-transcript != "" : Text {
                                text: "✓ 已完成转写";
                                font-size: 11px;
                                color: #3fb950;
                            }
                        }
                        Rectangle {
                            height: 140px;
                            background: #0d1117;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #21262d;
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.detail-transcript != "" ? root.detail-transcript : (root.detail-has-audio ? "尚未转写文稿。点击上方【🤖 AI语音转写】调用 Whisper 提取全文逐字稿。" : "此工时条目无附加麦克风录音。");
                                        font-size: 12px;
                                        color: root.detail-transcript != "" ? #c9d1d9 : #6e7681;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #21262d; }

                // 3. Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;

                    OutlineButton {
                        text: "📋 复制纪要与文稿";
                        custom-height: 32px;
                        clicked => {
                            root.copy-text-to-clipboard(root.detail-summary + "\n\n=== 录音转写文稿 ===\n" + root.detail-transcript);
                        }
                    }

                    PrimaryButton {
                        text: "关闭";
                        bg-color: #21262d;
                        hover-color: #30363d;
                        text-color: #c9d1d9;
                        custom-height: 32px;
                        clicked => { root.show-detail-modal = false; }
                    }
                }
            }
        }
    }
}
