// Software Name: 平行人天多项目工时管理与交付结算软件 (ParaDay)
// Version: V1.0
// Description: Multi-channel concurrent time-tracking & man-day billing engine.

import { LineEdit, ScrollView } from "std-widgets.slint";

export struct ProjectItem {
    id: string,
    name: string,
    client: string,
    rate-info: string,
    timer-text: string,
    days-text: string,
    amount-text: string,
    is-running: bool,
    is-paused: bool,
}

export struct EntryItem {
    id: string,
    project-name: string,
    duration-text: string,
    days-text: string,
    amount-text: string,
    summary-text: string,
    time-range: string,
}

export struct NoteItem {
    id: string,
    project-name: string,
    time-text: string,
    content: string,
}

export struct AfkItem {
    id: string,
    project-name: string,
    elapsed-text: string,
    is-deduct: bool,
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked <=> touch.clicked;

    height: 32px;
    border-radius: 6px;
    background: active ? #2563eb : (touch.has-hover ? #334155 : transparent);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? #ffffff : (touch.has-hover ? #f8fafc : #94a3b8);
            vertical-alignment: center;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #2563eb;
    in property <color> hover-color: #1d4ed8;
    in property <color> text-color: #ffffff;
    in property <length> custom-height: 32px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 6px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: root.text-color;
            vertical-alignment: center;
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <color> border-col: #475569;
    in property <color> text-color: #cbd5e1;
    in property <length> custom-height: 32px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? #94a3b8 : border-col;
    background: touch.pressed ? #334155 : (touch.has-hover ? #334155 : transparent);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: touch.has-hover ? #ffffff : root.text-color;
            vertical-alignment: center;
        }
    }
}

component MiniButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #0284c7;
    in property <color> hover-color: #0369a1;
    in property <color> text-color: #ffffff;
    callback clicked <=> touch.clicked;

    height: 28px;
    border-radius: 5px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: root.text-color;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "ParaDay - Multi-Channel Time Tracker v1.0";
    icon: @image-url("icon.png");
    min-width: 500px;
    min-height: 670px;
    preferred-width: 520px;
    preferred-height: 700px;
    background: #0f172a;

    // 0: 控制台, 1: 交付对账, 2: 闪念便签, 3: 设置中心, 4: 新建项目弹窗, 5: AFK离开校准弹窗
    in-out property <int> active-tab: 0;

    in property <string> total-days: "0.00";
    in property <string> total-amount: "¥ 0.00";
    in property <int> running-count: 0;
    in-out property <string> note-input: "";
    in-out property <string> toast-message: "";

    // 新建项目表单字段
    in-out property <string> new-proj-name: "";
    in-out property <string> new-proj-client: "";
    in-out property <string> new-proj-rate: "3000";
    in-out property <string> new-proj-currency: "CNY";
    in-out property <string> new-proj-git: "";

    // 快速会议与讨论字段
    in-out property <string> meeting-topic-input: "";
    in-out property <string> meeting-rate-input: "350";

    // 设置中心字段
    in-out property <string> setting-ai-base: "https://api.deepseek.com/v1";
    in-out property <string> setting-ai-key: "";
    in-out property <string> setting-ai-model: "deepseek-chat";
    in-out property <string> setting-hours-per-day: "8.0";
    in-out property <string> setting-afk-minutes: "10";

    // AFK 校准数据
    in-out property <string> afk-away-minutes: "30";
    in property <[AfkItem]> afk-items: [];

    in property <[ProjectItem]> projects: [];
    in property <[EntryItem]> recent-entries: [];
    in property <[NoteItem]> note-items: [];

    callback start-project(string /* project-id */);
    callback pause-project(string /* project-id */);
    callback resume-project(string /* project-id */);
    callback stop-project(string /* project-id */);
    callback delete-project(string /* project-id */);
    callback add-quick-note(string /* note-content */);
    callback delete-quick-note(string /* note-id */);
    callback submit-new-project();
    callback start-quick-meeting(string /* topic */, string /* rate */);
    callback save-settings();
    callback test-ai-connection();
    callback trigger-ai-summarize();
    callback copy-markdown();
    callback open-afk-modal();
    callback apply-afk-resolution(bool /* deduct-all */);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ================= 顶部全局标题栏 =================
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "ParaDay 平行人天";
                    font-size: 21px;
                    font-weight: 800;
                    color: #f8fafc;
                }
                Text {
                    text: "多通道并行工时与智能人天结算系统 V1.0";
                    font-size: 11px;
                    color: #94a3b8;
                }
            }

            // 状态徽标 (纯原生圆点)
            Rectangle {
                background: root.running-count > 0 ? #064e3b : #1e293b;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.running-count > 0 ? #10b981 : #475569;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.running-count > 0 ? #10b981 : #64748b;
                    }

                    Text {
                        text: root.running-count > 0 ? (root.running-count + " 个通道计时中") : "无活动通道";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.running-count > 0 ? #34d399 : #94a3b8;
                    }
                }
            }
        }

        // ================= 导航选项卡栏 (Tab Bar) =================
        Rectangle {
            height: 42px;
            background: #1e293b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #334155;

            HorizontalLayout {
                padding: 4px;
                spacing: 6px;

                TabButton {
                    text: "⏱ 控制台";
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                TabButton {
                    text: "📊 交付对账";
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                TabButton {
                    text: "📝 便签历史";
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                TabButton {
                    text: "⚙ 系统与AI设置";
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; }
                }
            }
        }

        // ================= Tab 0: 主控制台 =================
        if root.active-tab == 0 : VerticalLayout {
            spacing: 12px;

            // 今日数据概览卡片
            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #334155;

                HorizontalLayout {
                    padding: 12px;
                    alignment: space-around;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "今日核算总人天"; font-size: 11px; color: #94a3b8; }
                        Text { text: root.total-days + " 天"; font-size: 19px; font-weight: 800; color: #38bdf8; }
                    }
                    Rectangle { width: 1px; background: #334155; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: "今日累计预估收益"; font-size: 11px; color: #94a3b8; }
                        Text { text: root.total-amount; font-size: 19px; font-weight: 800; color: #10b981; }
                    }
                }
            }

            // 项目通道列表头部
            HorizontalLayout {
                alignment: space-between;
                Text { text: "进行中的项目通道"; font-size: 13px; font-weight: 700; color: #cbd5e1; }
                Text { text: "多项目可同时独立计时"; font-size: 11px; color: #64748b; }
            }

            ScrollView {
                height: 290px;
                VerticalLayout {
                    spacing: 8px;
                    for item in root.projects: Rectangle {
                        background: item.is-running ? #1e293b : (item.is-paused ? #1a2333 : #141e33);
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: item.is-running ? #0284c7 : (item.is-paused ? #d97706 : #1e293b);

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: item.name;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: #f1f5f9;
                                    }
                                    Rectangle {
                                        background: item.is-running ? #064e3b : (item.is-paused ? #78350f : #334155);
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: item.is-running ? "计时中" : (item.is-paused ? "已暂停" : item.client);
                                                font-size: 10px;
                                                color: item.is-running ? #34d399 : (item.is-paused ? #fbbf24 : #94a3b8);
                                            }
                                        }
                                    }
                                }
                                Text { text: item.rate-info; font-size: 11px; color: #64748b; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "[时] " + item.timer-text;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: item.is-running ? #38bdf8 : (item.is-paused ? #fbbf24 : #64748b);
                                    }
                                    Text { text: "[天] " + item.days-text; font-size: 12px; font-weight: 700; color: #f59e0b; }
                                    Text { text: "[额] " + item.amount-text; font-size: 12px; font-weight: 700; color: #10b981; }
                                }
                            }

                            // 按钮组
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                if !item.is-running && !item.is-paused : MiniButton {
                                    text: "▶ 启动计时";
                                    bg-color: #059669;
                                    hover-color: #047857;
                                    clicked => { root.start-project(item.id); }
                                }
                                if item.is-running : HorizontalLayout {
                                    spacing: 4px;
                                    MiniButton {
                                        text: "⏸ 暂停";
                                        bg-color: #d97706;
                                        hover-color: #b45309;
                                        clicked => { root.pause-project(item.id); }
                                    }
                                    MiniButton {
                                        text: "⏹ 结算";
                                        bg-color: #dc2626;
                                        hover-color: #b91c1c;
                                        clicked => { root.stop-project(item.id); }
                                    }
                                }
                                if item.is-paused : HorizontalLayout {
                                    spacing: 4px;
                                    MiniButton {
                                        text: "▶ 继续";
                                        bg-color: #2563eb;
                                        hover-color: #1d4ed8;
                                        clicked => { root.resume-project(item.id); }
                                    }
                                    MiniButton {
                                        text: "⏹ 结算";
                                        bg-color: #dc2626;
                                        hover-color: #b91c1c;
                                        clicked => { root.stop-project(item.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 闪念便签输入栏
            Rectangle {
                background: #1e293b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #334155;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: center;
                    LineEdit {
                        placeholder-text: "闪念便签：记录电话/讨论（敲回车自动存入便签库）...";
                        text <=> root.note-input;
                        accepted => {
                            if (root.note-input != "") {
                                root.add-quick-note(root.note-input);
                                root.note-input = "";
                            }
                        }
                    }
                    PrimaryButton {
                        text: "记便签";
                        bg-color: #0284c7;
                        hover-color: #0369a1;
                        clicked => {
                            if (root.note-input != "") {
                                root.add-quick-note(root.note-input);
                                root.note-input = "";
                            }
                        }
                    }
                }
            }

            // 底部操作栏
            HorizontalLayout {
                spacing: 8px;
                PrimaryButton {
                    text: "+ 新建项目";
                    bg-color: #2563eb;
                    hover-color: #1d4ed8;
                    custom-height: 36px;
                    clicked => { root.active-tab = 4; }
                }
                PrimaryButton {
                    text: "🎙️ 发起会议/讨论计时";
                    bg-color: #7c3aed;
                    hover-color: #6d28d9;
                    custom-height: 36px;
                    clicked => { root.active-tab = 6; }
                }
                OutlineButton {
                    text: "⚡ AFK校准";
                    custom-height: 36px;
                    clicked => { root.open-afk-modal(); }
                }
            }
        }

        // ================= Tab 1: 交付对账单 =================
        if root.active-tab == 1 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #334155;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "今日交付工时与流水明细"; font-size: 14px; font-weight: 700; color: #f1f5f9; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            PrimaryButton {
                                text: "✨ AI提炼总结";
                                bg-color: #7c3aed;
                                hover-color: #6d28d9;
                                custom-height: 32px;
                                clicked => { root.trigger-ai-summarize(); }
                            }
                            OutlineButton {
                                text: "📋 复制Markdown对账单";
                                custom-height: 32px;
                                clicked => { root.copy-markdown(); }
                            }
                        }
                    }

                    ScrollView {
                        height: 380px;
                        VerticalLayout {
                            spacing: 8px;
                            if root.recent-entries.length == 0 : Text {
                                text: "今日尚无已归档结算记录。在控制台点击【⏹ 结算】后自动生成。";
                                font-size: 12px;
                                color: #64748b;
                            }
                            for e in root.recent-entries : Rectangle {
                                background: #0f172a;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #334155;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: e.project-name; font-size: 13px; font-weight: 700; color: #38bdf8; }
                                        Text { text: e.time-range; font-size: 11px; color: #64748b; }
                                    }
                                    Text { text: e.summary-text; font-size: 12px; color: #e2e8f0; }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        Text { text: "工时: " + e.duration-text; font-size: 11px; color: #94a3b8; }
                                        Text { text: "折算: " + e.days-text; font-size: 11px; font-weight: 700; color: #f59e0b; }
                                        Text { text: "金额: " + e.amount-text; font-size: 11px; font-weight: 700; color: #10b981; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= Tab 2: 闪念便签历史 =================
        if root.active-tab == 2 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #334155;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text { text: "今日登记的闪念便签与电话记录"; font-size: 14px; font-weight: 700; color: #f1f5f9; }

                    ScrollView {
                        height: 400px;
                        VerticalLayout {
                            spacing: 8px;
                            if root.note-items.length == 0 : Text {
                                text: "今日暂无便签记录。可在控制台输入框随手登记需求与电话讨论。";
                                font-size: 12px;
                                color: #64748b;
                            }
                            for n in root.note-items : Rectangle {
                                background: #0f172a;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #334155;

                                HorizontalLayout {
                                    padding: 10px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: n.time-text; font-size: 11px; color: #38bdf8; }
                                            Text { text: "[" + n.project-name + "]"; font-size: 11px; color: #94a3b8; }
                                        }
                                        Text { text: n.content; font-size: 13px; color: #f8fafc; }
                                    }
                                    MiniButton {
                                        text: "删除";
                                        bg-color: #334155;
                                        hover-color: #dc2626;
                                        clicked => { root.delete-quick-note(n.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= Tab 3: 系统与 AI 设置 =================
        if root.active-tab == 3 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #334155;

                ScrollView {
                    height: 420px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text { text: "AI 大模型服务商设置 (用于工作总结生成)"; font-size: 14px; font-weight: 700; color: #38bdf8; }

                        Text { text: "API Base URL (兼容 OpenAI / DeepSeek / Ollama)"; font-size: 12px; color: #cbd5e1; }
                        LineEdit { text <=> root.setting-ai-base; }

                        Text { text: "API Key (密钥)"; font-size: 12px; color: #cbd5e1; }
                        LineEdit { text <=> root.setting-ai-key; placeholder-text: "sk-xxxxxxxxxxxx (可留空或填入本地 Ollama)"; }

                        Text { text: "模型名称 (Model)"; font-size: 12px; color: #cbd5e1; }
                        LineEdit { text <=> root.setting-ai-model; placeholder-text: "deepseek-chat"; }

                        HorizontalLayout {
                            spacing: 10px;
                            OutlineButton {
                                text: "🧪 测试 AI 连接";
                                border-col: #38bdf8;
                                text-color: #38bdf8;
                                custom-height: 34px;
                                clicked => { root.test-ai-connection(); }
                            }
                        }

                        Rectangle { height: 1px; background: #334155; }

                        Text { text: "工时与防遗漏守护规则"; font-size: 14px; font-weight: 700; color: #38bdf8; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "每日基准工时 (小时/人天)"; font-size: 12px; color: #cbd5e1; }
                                LineEdit { text <=> root.setting-hours-per-day; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "AFK 空闲离开阈值 (分钟)"; font-size: 12px; color: #cbd5e1; }
                                LineEdit { text <=> root.setting-afk-minutes; }
                            }
                        }

                        PrimaryButton {
                            text: "💾 保存全部系统设置";
                            bg-color: #059669;
                            hover-color: #047857;
                            custom-height: 38px;
                            clicked => { root.save-settings(); }
                        }
                    }
                }
            }
        }

        // ================= Tab 4: 新建项目弹窗 =================
        if root.active-tab == 4 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #334155;

                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text { text: "创建新的商业/个人项目"; font-size: 15px; font-weight: 800; color: #f8fafc; }

                    Text { text: "项目名称 (必填)"; font-size: 12px; color: #cbd5e1; }
                    LineEdit { placeholder-text: "例如：客户A 跨境商城二次重构"; text <=> root.new-proj-name; }

                    Text { text: "客户/组织名称"; font-size: 12px; color: #cbd5e1; }
                    LineEdit { placeholder-text: "例如：张总 / 某某科技有限公司"; text <=> root.new-proj-client; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "人天单价 (元/天)"; font-size: 12px; color: #cbd5e1; }
                            LineEdit { placeholder-text: "3000"; text <=> root.new-proj-rate; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "结算币种"; font-size: 12px; color: #cbd5e1; }
                            LineEdit { placeholder-text: "CNY"; text <=> root.new-proj-currency; }
                        }
                    }

                    Text { text: "本地 Git 仓库路径 (用于自动抓取 Commit & Diff)"; font-size: 12px; color: #cbd5e1; }
                    LineEdit { placeholder-text: "/home/beatle/dev/my-project (可选)"; text <=> root.new-proj-git; }

                    Rectangle { height: 6px; }

                    HorizontalLayout {
                        spacing: 10px;
                        PrimaryButton {
                            text: "确认保存并添加";
                            bg-color: #2563eb;
                            hover-color: #1d4ed8;
                            custom-height: 36px;
                            clicked => { root.submit-new-project(); }
                        }
                        OutlineButton {
                            text: "取消返回";
                            custom-height: 36px;
                            clicked => { root.active-tab = 0; }
                        }
                    }
                }
            }
        }

        // ================= Tab 5: AFK 离开电脑批量校准弹窗 =================
        if root.active-tab == 5 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #d97706;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "⚠️ 离开电脑工时校准保护"; font-size: 16px; font-weight: 800; color: #f59e0b; }
                    }

                    Text {
                        text: "系统检测到您此前离开了电脑约 " + root.afk-away-minutes + " 分钟。期间正在计时的项目如下：";
                        font-size: 12px;
                        color: #e2e8f0;
                    }

                    ScrollView {
                        height: 200px;
                        VerticalLayout {
                            spacing: 8px;
                            for a in root.afk-items : Rectangle {
                                background: #0f172a;
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding: 10px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        Text { text: a.project-name; font-size: 13px; font-weight: 700; color: #f1f5f9; }
                                        Text { text: "当前累计: " + a.elapsed-text; font-size: 11px; color: #94a3b8; }
                                    }
                                    Text { text: "建议扣除该段时间"; font-size: 11px; color: #f59e0b; }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        PrimaryButton {
                            text: "全部扣除空闲时间 (纯离开)";
                            bg-color: #d97706;
                            hover-color: #b45309;
                            custom-height: 36px;
                            clicked => { root.apply-afk-resolution(true); }
                        }
                        OutlineButton {
                            text: "全部保留 (后台测试/开会中)";
                            custom-height: 36px;
                            clicked => { root.apply-afk-resolution(false); }
                        }
                    }
                }
            }
        }

        // ================= Tab 6: 发起会议与讨论计时弹窗 =================
        if root.active-tab == 6 : VerticalLayout {
            spacing: 12px;

            Rectangle {
                background: #1e293b;
                border-radius: 10px;
                border-width: 1px;
                border-color: #7c3aed;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "🎙️ 发起会议 / 技术对齐 / 电话沟通计时"; font-size: 15px; font-weight: 800; color: #a78bfa; }
                    }

                    Text {
                        text: "现实中需求沟通、架构评审与客户电话同样属于高价值工时。系统将独立通道精准记录，并在结束时自动由 AI 提炼会议纪要。";
                        font-size: 12px;
                        color: #94a3b8;
                    }

                    Text { text: "会议/讨论议题"; font-size: 12px; color: #cbd5e1; }
                    LineEdit {
                        placeholder-text: "例如：客户需求对接与技术排期沟通会";
                        text <=> root.meeting-topic-input;
                    }

                    // 常用会议快捷芯片
                    HorizontalLayout {
                        spacing: 6px;
                        MiniButton {
                            text: "架构评审会";
                            bg-color: #334155;
                            hover-color: #475569;
                            clicked => { root.meeting-topic-input = "技术架构方案与接口评审会"; }
                        }
                        MiniButton {
                            text: "客户需求对接";
                            bg-color: #334155;
                            hover-color: #475569;
                            clicked => { root.meeting-topic-input = "商业客户需求与排期沟通会"; }
                        }
                        MiniButton {
                            text: "敏捷迭代站会";
                            bg-color: #334155;
                            hover-color: #475569;
                            clicked => { root.meeting-topic-input = "项目日常敏捷对齐与进度同步"; }
                        }
                        MiniButton {
                            text: "紧急排障讨论";
                            bg-color: #334155;
                            hover-color: #475569;
                            clicked => { root.meeting-topic-input = "线上紧急故障排查与复盘分析"; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "会议计费单价 (元/小时)"; font-size: 12px; color: #cbd5e1; }
                            LineEdit {
                                placeholder-text: "350";
                                text <=> root.meeting-rate-input;
                            }
                        }
                    }

                    Rectangle { height: 6px; }

                    HorizontalLayout {
                        spacing: 10px;
                        PrimaryButton {
                            text: "▶ 立即启动会议计时";
                            bg-color: #7c3aed;
                            hover-color: #6d28d9;
                            custom-height: 36px;
                            clicked => {
                                root.start-quick-meeting(root.meeting-topic-input, root.meeting-rate-input);
                            }
                        }
                        OutlineButton {
                            text: "取消返回";
                            custom-height: 36px;
                            clicked => { root.active-tab = 0; }
                        }
                    }
                }
            }
        }

        // 底部 Toast 提示信息栏
        if root.toast-message != "" : Rectangle {
            background: #064e3b;
            border-radius: 6px;
            HorizontalLayout {
                padding: 6px;
                alignment: center;
                Text { text: root.toast-message; font-size: 12px; color: #34d399; }
            }
        }
    }
}
