// Version: V0.1.0
// Description: Multi-channel concurrent time-tracking & man-day billing engine.

import { LineEdit, ScrollView } from "std-widgets.slint";

export struct ProjectItem {
    id: string,
    name: string,
    client: string,
    rate-info: string,
    timer-text: string,
    days-text: string,
    amount-text: string,
    is-running: bool,
    is-paused: bool,
    today-duration: string,
    entries-count: int,
}

export struct EntryItem {
    id: string,
    project-id: string,
    project-name: string,
    duration-text: string,
    days-text: string,
    amount-text: string,
    summary-text: string,
    time-range: string,
    date-str: string,
    has-audio: bool,
    audio-path: string,
    raw-secs: int,
}

export struct DayGroup {
    date-str: string,
    display-date: string,
    entries-count: int,
    total-duration: string,
    total-days: string,
    total-amount: string,
    entries: [EntryItem],
}

export struct NoteItem {
    id: string,
    project-id: string,
    project-name: string,
    time-text: string,
    content: string,
}

export struct AfkItem {
    id: string,
    project-name: string,
    elapsed-text: string,
    is-deduct: bool,
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #2563eb;
    in property <color> hover-color: #1d4ed8;
    in property <color> text-color: #ffffff;
    in property <length> custom-height: 34px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 8px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.text-color;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <color> border-col: #cbd5e1;
    in property <color> text-color: #1e293b;
    in property <length> custom-height: 30px;
    callback clicked <=> touch.clicked;

    height: custom-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? #94a3b8 : border-col;
    background: touch.pressed ? #e2e8f0 : (touch.has-hover ? #f1f5f9 : #ffffff);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: touch.has-hover ? #0f172a : root.text-color;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component MiniButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #238636;
    in property <color> hover-color: #2ea043;
    in property <color> text-color: #ffffff;
    callback clicked <=> touch.clicked;

    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? hover-color : (touch.has-hover ? hover-color : bg-color);

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 700;
            color: root.text-color;
            vertical-alignment: center;
            overflow: clip;
            wrap: no-wrap;
        }
    }
}

component ChipButton inherits Rectangle {
    in property <string> text;
    callback clicked <=> touch.clicked;

    height: 26px;
    border-radius: 6px;
    background: touch.pressed ? #e2e8f0 : (touch.has-hover ? #f1f5f9 : #ffffff);
    border-width: 1px;
    border-color: touch.has-hover ? #2563eb : #e2e8f0;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 500;
            color: touch.has-hover ? #0f172a : #475569;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

component SidebarTabItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> title: "";
    in property <bool> active: false;
    in property <bool> has-indicator: false;
    callback clicked <=> touch.clicked;

    height: 38px;
    border-radius: 8px;
    background: active ? #ffffff : (touch.has-hover ? #f1f5f9 : transparent);
    border-width: active ? 1px : 0px;
    border-color: active ? #e2e8f0 : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: root.icon;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: root.active ? 700 : 500;
                color: root.active ? #0f172a : (touch.has-hover ? #1e293b : #64748b);
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        if root.has-indicator : Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #16a34a;
            y: (parent.height - self.height) / 2;
        }
    }
}

component DarkInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <length> custom-height: 36px;
    in property <color> input-bg: #f8fafc;
    in property <color> border-col: #e2e8f0;
    in property <color> focus-border-col: #2563eb;
    callback accepted();
    callback edited(string);

    height: custom-height;
    background: input-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? focus-border-col : border-col;

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        color: #0f172a;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: #94a3b8;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ProjectSidebarCard inherits Rectangle {
    in property <string> name: "";
    in property <string> client: "";
    in property <string> rate-info: "";
    in property <string> today-duration: "";
    in property <int> entries-count: 0;
    in property <bool> is-running: false;
    in property <bool> is-paused: false;
    in property <bool> is-selected: false;
    callback clicked <=> touch.clicked;

    height: 64px;
    border-radius: 8px;
    background: is-selected ? #ffffff : (touch.has-hover ? #f8fafc : #f8fafc);
    border-width: 1px;
    border-color: is-selected ? #2563eb : (is-running ? #16a34a : (touch.has-hover ? #cbd5e1 : #e2e8f0));

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;
        alignment: center;

        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: is-running ? #16a34a : (is-paused ? #d97706 : #94a3b8);
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.name;
                    font-size: 14px;
                    font-weight: root.is-selected ? 800 : 600;
                    color: root.is-selected ? #2563eb : #0f172a;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }
            if root.is-running : Rectangle {
                height: 16px;
                border-radius: 3px;
                background: #f0fdf4;
                border-width: 1px;
                border-color: #bbf7d0;
                HorizontalLayout {
                    padding-left: 4px; padding-right: 4px;
                    Text { text: "计时中"; font-size: 9px; font-weight: 700; color: #16a34a; vertical-alignment: center; }
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.client;
                    font-size: 12px;
                    color: #64748b;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Text { text: "·"; font-size: 12px; color: #cbd5e1; }
                Text {
                    text: root.entries-count + "条明细";
                    font-size: 12px;
                    color: #64748b;
                }
            }
            Text {
                text: root.today-duration != "" && root.today-duration != "00:00:00" ? root.today-duration : "";
                font-size: 12px;
                font-weight: 700;
                color: #2563eb;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "MythManDay - Multi-Channel Time Tracker v0.1.0";
    icon: @image-url("icon.png");
    default-font-family: "Noto Sans CJK SC, PingFang SC, Microsoft YaHei, sans-serif";
    default-font-size: 14px;
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1180px;
    preferred-height: 780px;
    background: #f8fafc;

    // 0: 项目工作区, 1: 全局工时统计, 2: 系统与AI设置
    in-out property <int> active-tab: 0;

    // AI 提供商: "agy" | "codex" | "api"
    in-out property <string> setting-ai-provider: "agy";

    // 当前在左侧项目列表选中的项目ID (默认空，将在启动时选中首个)
    in-out property <string> selected-project-id: "";

    // 独立模态浮层控制
    in-out property <bool> show-meeting-modal: false;
    in-out property <bool> show-new-project-modal: false;
    in-out property <bool> show-afk-modal: false;
    in-out property <bool> show-detail-modal: false;

    // 会议纪要与录音文稿详情字段
    in-out property <string> detail-entry-id: "";
    in-out property <string> detail-project-name: "";
    in-out property <string> detail-time-range: "";
    in-out property <string> detail-duration: "";
    in-out property <string> detail-days: "";
    in-out property <string> detail-amount: "";
    in-out property <string> detail-summary: "";
    in-out property <string> detail-transcript: "";
    in-out property <string> detail-audio-path: "";
    in-out property <bool> detail-has-audio: false;

    in property <string> total-days: "0.00";
    in property <string> total-amount: "¥ 0.00";
    in property <int> running-count: 0;
    in-out property <string> note-input: "";
    in-out property <string> toast-message: "";

    // 新建项目表单字段
    in-out property <string> new-proj-name: "";
    in-out property <string> new-proj-client: "";
    in-out property <string> new-proj-rate: "3000";
    in-out property <string> new-proj-currency: "CNY";
    in-out property <string> new-proj-git: "";

    // 快速会议与讨论字段
    in-out property <int> meeting-selected-proj-idx: -1;
    in-out property <string> meeting-selected-proj-name: "独立临时会议";
    in-out property <string> meeting-selected-proj-client: "临时立项";
    in-out property <string> meeting-selected-proj-rate: "350 CNY / 小时";
    in-out property <string> meeting-topic-input: "";
    in-out property <string> meeting-rate-input: "350";
    in-out property <bool> meeting-record-audio: true;

    // 麦克风录音与声波状态
    in property <bool> is-recording-audio: false;
    in property <bool> is-audio-paused: false;
    in property <string> audio-timer-text: "00:00:00";
    in property <float> audio-volume-level: 0.0;
    in property <string> active-recording-project-name: "";
    in property <string> playing-audio-path: "";
    in property <string> playing-entry-id: "";

    // 设置中心字段
    in-out property <string> setting-ai-base: "https://api.openai.com/v1";
    in-out property <string> setting-ai-key: "";
    in-out property <string> setting-ai-model: "gpt-4o-mini";
    in-out property <string> setting-hours-per-day: "8.0";
    in-out property <string> setting-afk-minutes: "10";

    // AFK 校准数据
    in-out property <string> afk-away-minutes: "30";
    in property <[AfkItem]> afk-items: [];

    in property <[ProjectItem]> projects: [];
    in property <[EntryItem]> recent-entries: [];
    in property <[DayGroup]> daily-groups: [];
    in property <[NoteItem]> note-items: [];

    callback select-project(string /* project-id */);
    callback start-project(string /* project-id */);
    callback pause-project(string /* project-id */);
    callback resume-project(string /* project-id */);
    callback stop-project(string /* project-id */);
    callback delete-project(string /* project-id */);
    callback add-quick-note(string /* note-content */);
    callback add-project-note(string /* project-id */, string /* content */);
    callback delete-quick-note(string /* note-id */);
    callback submit-new-project();
    callback start-quick-meeting(int /* proj-idx */, string /* topic */, string /* rate */, bool /* record-audio */);
    callback select-meeting-project(int /* proj-idx */);
    callback open-meeting-modal();
    callback toggle-audio-pause();
    callback stop-audio-recording();
    callback play-entry-audio(string /* entry-id */, string /* audio-path */);
    callback stop-audio-playback();
    callback open-entry-folder(string /* audio-path */);
    callback transcribe-entry-audio(string /* entry-id */, string /* audio-path */);
    callback save-settings();
    callback test-ai-connection();
    callback trigger-ai-summarize();
    callback copy-markdown();
    callback open-afk-modal();
    callback apply-afk-resolution(bool /* deduct-all */);
    callback open-entry-detail(string /* entry-id */);
    callback copy-text-to-clipboard(string /* text */);

    // ==================== 主工作区水平双栏布局 ====================
    HorizontalLayout {
        // ----------------- 左侧导航边栏 (230px 宽) -----------------
        Rectangle {
            width: 230px;
            background: #f8fafc;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: space-between;

                // 边栏上半部分
                VerticalLayout {
                    spacing: 16px;

                    // 品牌区
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #2563eb;
                            Text {
                                text: "P";
                                font-size: 16px;
                                font-weight: 900;
                                color: #ffffff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "MythManDay";
                                font-size: 16px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                            Text {
                                text: "平行人天 · 研发计费";
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    // 核心主动作：发起会议沟通 (全宽单行，永远不折行)
                    PrimaryButton {
                        text: "🎙️ 发起会议沟通";
                        bg-color: #2563eb;
                        hover-color: #1d4ed8;
                        custom-height: 38px;
                        clicked => {
                            root.open-meeting-modal();
                        }
                    }

                    // 导航菜单列表
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-bottom: 4px;
                            Text {
                                text: "工作台";
                                font-size: 11px;
                                font-weight: 700;
                                color: #94a3b8;
                            }
                        }

                        SidebarTabItem {
                            icon: "📁";
                            title: "项目工作区";
                            active: root.active-tab == 0;
                            has-indicator: root.running-count > 0;
                            clicked => { root.active-tab = 0; }
                        }

                        SidebarTabItem {
                            icon: "📈";
                            title: "全局工时统计";
                            active: root.active-tab == 1;
                            clicked => { root.active-tab = 1; }
                        }

                        SidebarTabItem {
                            icon: "⚙️";
                            title: "系统与AI设置";
                            active: root.active-tab == 2;
                            clicked => { root.active-tab = 2; }
                        }
                    }
                }

                // 边栏底部：今日累计研发工时
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: "今日累计投入";
                            font-size: 11px;
                            color: #64748b;
                        }

                        Text {
                            text: root.total-days + " 人天";
                            font-size: 18px;
                            font-weight: 900;
                            color: #16a34a;
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "核算价值:";
                                font-size: 11px;
                                color: #64748b;
                            }
                            Text {
                                text: root.total-amount;
                                font-size: 11px;
                                font-weight: 700;
                                color: #0f172a;
                            }
                        }
                    }
                }
            }
        }

        // 垂直分割线
        Rectangle {
            width: 1px;
            background: #e2e8f0;
        }

        // ----------------- 右侧主工作区画布 -----------------
        Rectangle {
            background: #f8fafc;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // 顶部 Header (标题 + 动作按钮)
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.active-tab == 0 ? "项目工作区" : (root.active-tab == 1 ? "全局工时统计与日报" : "系统配置与AI引擎");
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: root.active-tab == 0 ? "以项目为中心 · 实时秒级时钟 · 工时明细与会议录音一体化管理" : (root.active-tab == 1 ? "全项目工时透视 · AI一键提炼工作日报 · Markdown格式导出" : "支持本地免Key agy/codex 与云端大模型 · AFK 防摸鱼守护");
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    // 右侧动作按钮区 (单行横排，按钮文字绝不换行！)
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        // 状态徽标
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: root.running-count > 0 ? #f0fdf4 : #ffffff;
                            border-width: 1px;
                            border-color: root.running-count > 0 ? #bbf7d0 : #e2e8f0;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.running-count > 0 ? #16a34a : #94a3b8;
                                }
                                Text {
                                    text: root.running-count > 0 ? (root.running-count + " 个通道计时中") : "无活动通道";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.running-count > 0 ? #16a34a : #64748b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // 新建项目按钮 (单行水平)
                        OutlineButton {
                            text: "➕ 新建项目";
                            custom-height: 28px;
                            clicked => {
                                root.show-new-project-modal = true;
                            }
                        }

                        // AFK校准按钮 (单行水平)
                        OutlineButton {
                            text: "⚡ AFK校准";
                            custom-height: 28px;
                            clicked => {
                                root.open-afk-modal();
                            }
                        }
                    }
                }

                // 录音状态微幅横幅 (录音时显示)
                if root.is-recording-audio : Rectangle {
                    height: 40px;
                    background: #eff6ff;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #bfdbfe;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #2563eb;
                            }
                            Text {
                                text: "🎙️ 会议录音中: " + root.active-recording-project-name + " · " + root.audio-timer-text;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1e40af;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            MiniButton {
                                text: root.is-audio-paused ? "▶ 继续录音" : "⏸ 暂停录音";
                                bg-color: #d97706;
                                hover-color: #b45309;
                                clicked => { root.toggle-audio-pause(); }
                            }
                            MiniButton {
                                text: "⏹ 结束录音";
                                bg-color: #dc2626;
                                hover-color: #b91c1c;
                                clicked => { root.stop-audio-recording(); }
                            }
                        }
                    }
                }

                // ================= Tab 0: 📁 左右分屏项目工作区 =================
                if root.active-tab == 0 : HorizontalLayout {
                    spacing: 14px;

                    // ------------------ 左侧：项目列表面板 (固定 240px 宽) ------------------
                    Rectangle {
                        width: 240px;
                        background: #ffffff;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "📁 研发与会议项目"; font-size: 13px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                                Text { text: root.projects.length + " 个项目"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                            }

                            // 项目列表滑动区域
                            ScrollView {
                                height: 630px;
                                VerticalLayout {
                                    padding-right: 4px;
                                    spacing: 8px;

                                    if root.projects.length == 0 : Rectangle {
                                        height: 80px;
                                        Text { text: "暂无项目，点击右上角【+ 新建项目】"; font-size: 11px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                                    }

                                    for p in root.projects : ProjectSidebarCard {
                                        name: p.name;
                                        client: p.client;
                                        rate-info: p.rate-info;
                                        today-duration: p.today-duration;
                                        entries-count: p.entries-count;
                                        is-running: p.is-running;
                                        is-paused: p.is-paused;
                                        is-selected: root.selected-project-id == p.id;
                                        clicked => {
                                            root.selected-project-id = p.id;
                                            root.select-project(p.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ------------------ 右侧：选中项目的工时明细看板 (一天一个卡片) ------------------
                    Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 12px;

                            // 1. 顶部操作栏 (时钟与计时控制)
                            for item[proj-idx] in root.projects : VerticalLayout {
                                if root.selected-project-id == item.id : Rectangle {
                                    background: #ffffff;
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: item.is-running ? #16a34a : #e2e8f0;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            spacing: 8px;

                                            // 第一行：项目名称、标签、以及右侧时钟与操作按钮
                                            HorizontalLayout {
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    alignment: start;
                                                    Text { text: item.name; font-size: 18px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                                                    Rectangle {
                                                        height: 22px;
                                                        border-radius: 4px;
                                                        background: #f1f5f9;
                                                        border-width: 1px;
                                                        border-color: #cbd5e1;
                                                        HorizontalLayout {
                                                            padding-left: 8px; padding-right: 8px;
                                                            Text { text: item.client; font-size: 12px; font-weight: 600; color: #475569; vertical-alignment: center; }
                                                        }
                                                    }
                                                    if item.is-running : Rectangle {
                                                        height: 22px;
                                                        border-radius: 4px;
                                                        background: #f0fdf4;
                                                        border-width: 1px;
                                                        border-color: #86efac;
                                                        HorizontalLayout {
                                                            padding-left: 8px; padding-right: 8px;
                                                            Text { text: "● 正在计时"; font-size: 11px; font-weight: 700; color: #15803d; vertical-alignment: center; }
                                                        }
                                                    }
                                                }

                                                // 右侧大时钟与控制按钮
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    alignment: end;

                                                    Text {
                                                        text: item.timer-text;
                                                        font-size: 24px;
                                                        font-weight: 900;
                                                        font-family: "DejaVu Sans Mono, monospace";
                                                        color: item.is-running ? #16a34a : #475569;
                                                        vertical-alignment: center;
                                                    }

                                                    if !item.is-running && !item.is-paused : HorizontalLayout {
                                                        spacing: 8px;
                                                        MiniButton {
                                                            width: 96px;
                                                            text: "▶ 开始工时";
                                                            bg-color: #16a34a;
                                                            hover-color: #15803d;
                                                            clicked => { root.start-project(item.id); }
                                                        }
                                                        MiniButton {
                                                            width: 96px;
                                                            text: "🎙️ 发起会议";
                                                            bg-color: #2563eb;
                                                            hover-color: #1d4ed8;
                                                            clicked => {
                                                                root.select-meeting-project(proj-idx);
                                                                root.open-meeting-modal();
                                                            }
                                                        }
                                                    }
                                                    if item.is-running : HorizontalLayout {
                                                        spacing: 8px;
                                                        MiniButton {
                                                            width: 76px;
                                                            text: "⏸ 暂停";
                                                            bg-color: #d97706;
                                                            hover-color: #b45309;
                                                            clicked => { root.pause-project(item.id); }
                                                        }
                                                        MiniButton {
                                                            width: 92px;
                                                            text: "⏹ 结束工时";
                                                            bg-color: #dc2626;
                                                            hover-color: #b91c1c;
                                                            clicked => { root.stop-project(item.id); }
                                                        }
                                                    }
                                                    if item.is-paused : HorizontalLayout {
                                                        spacing: 8px;
                                                        MiniButton {
                                                            width: 92px;
                                                            text: "▶ 继续工时";
                                                            bg-color: #16a34a;
                                                            hover-color: #15803d;
                                                            clicked => { root.resume-project(item.id); }
                                                        }
                                                        MiniButton {
                                                            width: 92px;
                                                            text: "⏹ 结束工时";
                                                            bg-color: #dc2626;
                                                            hover-color: #b91c1c;
                                                            clicked => { root.stop-project(item.id); }
                                                        }
                                                    }
                                                }
                                            }

                                            // 第二行：核算基准与今日累计投入提示横条
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text { text: "核算标准: " + item.rate-info; font-size: 13px; font-weight: 500; color: #475569; }
                                                Text { text: "•"; font-size: 13px; color: #cbd5e1; }
                                                Text { text: "今日累计投入: " + item.today-duration + " (" + item.days-text + ")"; font-size: 13px; font-weight: 700; color: #1d4ed8; }
                                            }
                                        }

                                        // 快速工作备忘输入框 (当前选中项目)
                                        HorizontalLayout {
                                            spacing: 8px;
                                            proj_note_input := DarkInput {
                                                custom-height: 32px;
                                                placeholder: "为【" + item.name + "】添加工作备忘、需求变更或沟通速记...";
                                                accepted => {
                                                    if (self.text != "") {
                                                        root.add-project-note(item.id, self.text);
                                                        self.text = "";
                                                    }
                                                }
                                            }
                                            PrimaryButton {
                                                width: 88px;
                                                text: "存入备忘";
                                                bg-color: #f1f5f9;
                                                hover-color: #e2e8f0;
                                                text-color: #334155;
                                                custom-height: 32px;
                                                clicked => {
                                                    if (proj_note_input.text != "") {
                                                        root.add-project-note(item.id, proj_note_input.text);
                                                        proj_note_input.text = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 2. 每天一个卡片的历史工时明细流水 (包含录音、转写与交付纪要)
                            ScrollView {
                                height: 560px;
                                VerticalLayout {
                                    padding-right: 4px;
                                    spacing: 12px;

                                    // 【每日卡片流】：一天一个独立卡片呈现，支持多天流水浏览
                                    for day in root.daily-groups : Rectangle {
                                        background: #ffffff;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: #e2e8f0;

                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 10px;

                                            // 卡片 Header：日期与当天小计
                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: center;
                                                    Rectangle { width: 4px; height: 14px; border-radius: 2px; background: #2563eb; }
                                                    Text { text: "📅 " + day.display-date; font-size: 14px; font-weight: 800; color: #0f172a; }
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: 4px;
                                                        background: #eff6ff;
                                                        border-width: 1px;
                                                        border-color: #dbeafe;
                                                        HorizontalLayout {
                                                            padding-left: 7px;
                                                            padding-right: 7px;
                                                            Text { text: day.entries-count + " 笔工时记录"; font-size: 11px; font-weight: 700; color: #2563eb; vertical-alignment: center; }
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    alignment: center;
                                                    Text { text: "投入: " + day.total-duration; font-size: 12px; color: #64748b; vertical-alignment: center; }
                                                    Text { text: "折合: " + day.total-days; font-size: 12px; font-weight: 700; color: #d97706; vertical-alignment: center; }
                                                    Text { text: "价值: " + day.total-amount; font-size: 12px; font-weight: 700; color: #16a34a; vertical-alignment: center; }
                                                }
                                            }

                                            // 分割线
                                            Rectangle { height: 1px; background: #f1f5f9; }

                                            // 当天的明细条目列表
                                            VerticalLayout {
                                                spacing: 8px;

                                                for e in day.entries : Rectangle {
                                                    background: #f8fafc;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: #e2e8f0;

                                                    VerticalLayout {
                                                        padding: 10px;
                                                        spacing: 6px;

                                                        // 第一行：时间区间与投入产出
                                                        HorizontalLayout {
                                                            alignment: space-between;
                                                            HorizontalLayout {
                                                                spacing: 14px;
                                                                Text { text: "🕒 " + e.time-range; font-size: 14px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                                                                Text { text: "投入: " + e.duration-text; font-size: 13px; font-weight: 600; color: #475569; vertical-alignment: center; }
                                                                Text { text: "折算: " + e.days-text; font-size: 13px; font-weight: 700; color: #b45309; vertical-alignment: center; }
                                                                Text { text: "价值: " + e.amount-text; font-size: 13px; font-weight: 800; color: #15803d; vertical-alignment: center; }
                                                            }
                                                        }

                                                        // 第二行：AI 会议纪要与交付成果内容
                                                        Text {
                                                            text: e.summary-text;
                                                            font-size: 14px;
                                                            font-weight: 500;
                                                            color: #0f172a;
                                                            wrap: word-wrap;
                                                        }

                                                        // 第三行：录音播放、AI转写与文稿操作栏
                                                        HorizontalLayout {
                                                            alignment: space-between;

                                                            if e.has-audio : HorizontalLayout {
                                                                spacing: 6px;
                                                                alignment: start;
                                                                MiniButton {
                                                                    text: root.playing-entry-id == e.id ? "⏹ 停止播放" : "▶ 播放录音";
                                                                    bg-color: root.playing-entry-id == e.id ? #da3633 : #6366f1;
                                                                    hover-color: root.playing-entry-id == e.id ? #b62324 : #4f46e5;
                                                                    clicked => {
                                                                        if (root.playing-entry-id == e.id) {
                                                                            root.stop-audio-playback();
                                                                        } else {
                                                                            root.play-entry-audio(e.id, e.audio-path);
                                                                        }
                                                                    }
                                                                }
                                                                OutlineButton {
                                                                    text: "📂 录音目录";
                                                                    custom-height: 24px;
                                                                    clicked => { root.open-entry-folder(e.audio-path); }
                                                                }
                                                                MiniButton {
                                                                    text: "🤖 AI转写";
                                                                    bg-color: #238636;
                                                                    hover-color: #2ea043;
                                                                    clicked => { root.transcribe-entry-audio(e.id, e.audio-path); }
                                                                }
                                                            }

                                                            if !e.has-audio : Rectangle {}

                                                            OutlineButton {
                                                                text: "📄 查看纪要与文稿";
                                                                custom-height: 24px;
                                                                clicked => { root.open-entry-detail(e.id); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 【项目即时备忘随手记卡片】
                                    Rectangle {
                                        background: #ffffff;
                                        border-radius: 12px;
                                        border-width: 1px;
                                        border-color: #e2e8f0;

                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 8px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: center;
                                                Text { text: "📝 项目即时备忘流水"; font-size: 12px; font-weight: 700; color: #64748b; }
                                            }

                                            for n in root.note-items : VerticalLayout {
                                                if n.project-id == root.selected-project-id : Rectangle {
                                                    height: 28px;
                                                    background: #f8fafc;
                                                    border-radius: 6px;
                                                    border-width: 1px;
                                                    border-color: #e2e8f0;
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 8px;
                                                        alignment: space-between;
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: center;
                                                            Text { text: "📝 [" + n.time-text + "]"; font-size: 11px; color: #2563eb; vertical-alignment: center; }
                                                            Text { text: n.content; font-size: 11px; color: #1e293b; vertical-alignment: center; }
                                                        }
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.delete-quick-note(n.id); }
                                                            Text { text: "✕"; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ================= Tab 1: 全局工时统计与日报 =================
                if root.active-tab == 1 : VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #ffffff;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "今日全项目研发工时汇总"; font-size: 15px; font-weight: 700; color: #0f172a; }
                                    Text { text: "跨项目工时聚合 · 阶梯人天核算 · 快速生成并导出技术日报"; font-size: 11px; color: #64748b; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PrimaryButton {
                                        text: "✨ AI生成工作日报";
                                        bg-color: #6366f1;
                                        hover-color: #4f46e5;
                                        custom-height: 32px;
                                        clicked => { root.trigger-ai-summarize(); }
                                    }
                                    OutlineButton {
                                        text: "📋 复制 Markdown 日报";
                                        custom-height: 32px;
                                        clicked => { root.copy-markdown(); }
                                    }
                                }
                            }

                            // 统计卡片三连
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    background: #f8fafc;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "今日总核算工时"; font-size: 11px; color: #64748b; }
                                        Text { text: root.total-days + " 人天"; font-size: 18px; font-weight: 800; color: #16a34a; }
                                    }
                                }
                                Rectangle {
                                    background: #f8fafc;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "今日核算价值"; font-size: 11px; color: #64748b; }
                                        Text { text: root.total-amount; font-size: 18px; font-weight: 800; color: #0f172a; }
                                    }
                                }
                                Rectangle {
                                    background: #f8fafc;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "当前活跃通道"; font-size: 11px; color: #64748b; }
                                        Text { text: root.running-count > 0 ? (root.running-count + " 个计时中") : "无活动通道"; font-size: 18px; font-weight: 800; color: root.running-count > 0 ? #16a34a : #94a3b8; }
                                    }
                                }
                            }

                            ScrollView {
                                height: 380px;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 8px;
                                    if root.recent-entries.length == 0 : Text {
                                        text: "今日尚无已归档工时记录。在项目工作区点击【⏹ 结束工时】后自动记录入库。";
                                        font-size: 12px;
                                        color: #94a3b8;
                                    }
                                    for e in root.recent-entries : Rectangle {
                                        background: #f8fafc;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #e2e8f0;

                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: center;
                                                    Text { text: "📁 " + e.project-name; font-size: 13px; font-weight: 700; color: #58a6ff; }
                                                    Text { text: "🕒 " + e.time-range; font-size: 11px; color: #64748b; }
                                                }
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    Text { text: "工时: " + e.duration-text; font-size: 11px; color: #64748b; }
                                                    Text { text: "折算: " + e.days-text; font-size: 11px; font-weight: 700; color: #d29922; }
                                                    Text { text: "价值: " + e.amount-text; font-size: 11px; font-weight: 700; color: #3fb950; }
                                                }
                                            }
                                            Text { text: e.summary-text; font-size: 12px; color: #334155; wrap: word-wrap; }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: space-between;

                                                if e.has-audio : HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    MiniButton {
                                                        text: root.playing-entry-id == e.id ? "⏹ 停止播放" : "▶ 播放录音";
                                                        bg-color: root.playing-entry-id == e.id ? #da3633 : #6366f1;
                                                        hover-color: root.playing-entry-id == e.id ? #b62324 : #4f46e5;
                                                        clicked => {
                                                            if (root.playing-entry-id == e.id) {
                                                                root.stop-audio-playback();
                                                            } else {
                                                                root.play-entry-audio(e.id, e.audio-path);
                                                            }
                                                        }
                                                    }
                                                    OutlineButton {
                                                        text: "📂 录音目录";
                                                        custom-height: 24px;
                                                        clicked => { root.open-entry-folder(e.audio-path); }
                                                    }
                                                    MiniButton {
                                                        text: "🤖 AI转写";
                                                        bg-color: #238636;
                                                        hover-color: #2ea043;
                                                        clicked => { root.transcribe-entry-audio(e.id, e.audio-path); }
                                                    }
                                                }

                                                if !e.has-audio : Rectangle {}

                                                OutlineButton {
                                                    text: "📄 查看纪要与文稿";
                                                    custom-height: 24px;
                                                    clicked => { root.open-entry-detail(e.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ================= Tab 2: ⚙️ 系统与 AI 设置 =================
                if root.active-tab == 2 : VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #ffffff;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        ScrollView {
                            height: 520px;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                Text { text: "🤖 AI 引擎服务商配置 (用于工时成果提炼与会议纪要分析)"; font-size: 15px; font-weight: 700; color: #58a6ff; }

                                // 提供商选择 Chips
                                HorizontalLayout {
                                    spacing: 10px;
                                    ChipButton {
                                        text: root.setting-ai-provider == "agy" ? "● agy CLI (推荐 · 本地免Key)" : "○ agy CLI (本地免Key)";
                                        clicked => { root.setting-ai-provider = "agy"; }
                                    }
                                    ChipButton {
                                        text: root.setting-ai-provider == "codex" ? "● codex CLI (本地免Key)" : "○ codex CLI (本地免Key)";
                                        clicked => { root.setting-ai-provider = "codex"; }
                                    }
                                    ChipButton {
                                        text: root.setting-ai-provider == "api" ? "● 自定义 API (OpenAI/DeepSeek)" : "○ 自定义 API";
                                        clicked => { root.setting-ai-provider = "api"; }
                                    }
                                }

                                if root.setting-ai-provider == "agy" : Rectangle {
                                    height: 52px;
                                    background: #f0fdf4;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #bbf7d0;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 10px;
                                        alignment: start;
                                        Text { text: "✨"; font-size: 16px; vertical-alignment: center; }
                                        Text {
                                            text: "已启用 agy CLI。MythManDay 将直接调用本地已安装认证的 `agy` 命令行，无需填写或购买 API Key！";
                                            font-size: 12px;
                                            color: #16a34a;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.setting-ai-provider == "codex" : Rectangle {
                                    height: 52px;
                                    background: #eff6ff;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #bfdbfe;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 10px;
                                        alignment: start;
                                        Text { text: "⚡"; font-size: 16px; vertical-alignment: center; }
                                        Text {
                                            text: "已启用 codex CLI。MythManDay 将直接调用本地 `codex` 命令行，开箱即用，无需配置 API Key！";
                                            font-size: 12px;
                                            color: #2563eb;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.setting-ai-provider == "api" : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "API Base URL (兼容 OpenAI / DeepSeek / Ollama)"; font-size: 12px; color: #64748b; }
                                    DarkInput { text <=> root.setting-ai-base; }

                                    Text { text: "API Key (密钥)"; font-size: 12px; color: #64748b; }
                                    DarkInput { text <=> root.setting-ai-key; placeholder: "sk-xxxxxxxxxxxx (可留空或填入本地 Ollama)"; }

                                    Text { text: "模型名称 (Model)"; font-size: 12px; color: #64748b; }
                                    DarkInput { text <=> root.setting-ai-model; placeholder: "gpt-4o-mini"; }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    OutlineButton {
                                        text: "🧪 测试当前 AI 引擎连通性";
                                        border-col: #58a6ff;
                                        text-color: #58a6ff;
                                        custom-height: 32px;
                                        clicked => { root.test-ai-connection(); }
                                    }
                                }

                                Rectangle { height: 1px; background: #f1f5f9; }

                                Text { text: "⏱️ 工时基准与防摸鱼守护规则"; font-size: 14px; font-weight: 700; color: #58a6ff; }

                                HorizontalLayout {
                                    spacing: 14px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "每日基准工时 (小时/人天)"; font-size: 12px; color: #64748b; }
                                        DarkInput { text <=> root.setting-hours-per-day; }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "AFK 空闲离开阈值 (分钟)"; font-size: 12px; color: #64748b; }
                                        DarkInput { text <=> root.setting-afk-minutes; }
                                    }
                                }

                                PrimaryButton {
                                    text: "💾 保存全部系统设置";
                                    bg-color: #238636;
                                    hover-color: #2ea043;
                                    custom-height: 36px;
                                    clicked => { root.save-settings(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==================== 底部 Toast 提示 (无弹窗时显示，绝不遮挡弹窗) ====================
    if root.toast-message != "" && !root.show-meeting-modal && !root.show-new-project-modal && !root.show-afk-modal && !root.show-detail-modal : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 48px;
        height: 36px;
        background: #f0fdf4;
        border-radius: 18px;
        border-width: 1px;
        border-color: #86efac;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;
            Text { text: root.toast-message; font-size: 12px; font-weight: 600; color: #16a34a; vertical-alignment: center; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toast-message = ""; }
                Text { text: "✕"; font-size: 11px; color: #64748b; vertical-alignment: center; }
            }
        }
    }

    // ==================== 独立居中 Modal 1: 发起会议弹窗 ====================
    if root.show-meeting-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        // 点击半透明遮罩背景即可快速关闭弹窗
        TouchArea {
            clicked => { root.show-meeting-modal = false; }
        }

        // 居中卡片本体 (固定高度与布局，Header/Footer 永不裁切)
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 530px;
            height: 450px;
            background: #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: #e2e8f0;

            // 拦截卡片内部点击，防止误触发背景关闭
            TouchArea {}

            VerticalLayout {
                // 1. 顶部 Header (固定 46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #6366f1;
                            Text {
                                text: "🎙️";
                                font-size: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "发起即时会议与讨论"; font-size: 15px; font-weight: 800; color: #0f172a; }
                            Text { text: "独立计时通道 · 录音直写本地 · 自动提炼AI纪要"; font-size: 11px; color: #64748b; }
                        }
                    }

                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-meeting-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #e2e8f0 : #f1f5f9;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #64748b;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 顶部分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // 2. 表单核心内容区
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    // 关联客户项目
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "关联客户项目"; font-size: 12px; font-weight: 700; color: #334155; }
                        Text { text: "临时会议单独立项，不计入既有项目"; font-size: 11px; color: #94a3b8; }
                    }

                    ScrollView {
                        height: 80px;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 5px;

                            // 临时会议
                            Rectangle {
                                height: 32px;
                                background: root.meeting-selected-proj-idx == -1 ? #eff6ff : #ffffff;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.meeting-selected-proj-idx == -1 ? #2563eb : #e2e8f0;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-meeting-project(-1); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "⚡ 独立临时会议 (单独立项 · 不计入客户)";
                                        font-size: 12px;
                                        font-weight: root.meeting-selected-proj-idx == -1 ? 700 : 500;
                                        color: root.meeting-selected-proj-idx == -1 ? #ffffff : #c9d1d9;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.meeting-selected-proj-idx == -1 ? "✓ 已选" : "选择";
                                        font-size: 11px;
                                        color: root.meeting-selected-proj-idx == -1 ? #818cf8 : #6e7681;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 客户项目列表
                            for p[idx] in root.projects : Rectangle {
                                height: 32px;
                                background: root.meeting-selected-proj-idx == idx ? #eff6ff : #ffffff;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.meeting-selected-proj-idx == idx ? #2563eb : #e2e8f0;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-meeting-project(idx); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Text {
                                            text: "📁 " + p.name;
                                            font-size: 12px;
                                            font-weight: root.meeting-selected-proj-idx == idx ? 700 : 500;
                                            color: root.meeting-selected-proj-idx == idx ? #ffffff : #c9d1d9;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "[" + p.client + "]";
                                            font-size: 10px;
                                            color: #94a3b8;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.meeting-selected-proj-idx == idx ? "✓ 已选" : "选择";
                                        font-size: 11px;
                                        color: root.meeting-selected-proj-idx == idx ? #818cf8 : #6e7681;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // 议题
                    Text { text: "会议/讨论议题"; font-size: 12px; font-weight: 700; color: #334155; }
                    DarkInput {
                        custom-height: 32px;
                        placeholder: "例如：商业客户需求沟通与技术方案评审";
                        text <=> root.meeting-topic-input;
                    }

                    // 快速标签 Chips
                    HorizontalLayout {
                        spacing: 6px;
                        ChipButton {
                            text: "架构方案评审";
                            clicked => { root.meeting-topic-input = "技术架构方案与接口评审会"; }
                        }
                        ChipButton {
                            text: "客户需求对接";
                            clicked => { root.meeting-topic-input = "商业客户需求与排期沟通会"; }
                        }
                        ChipButton {
                            text: "敏捷迭代站会";
                            clicked => { root.meeting-topic-input = "项目日常敏捷对齐与进度同步"; }
                        }
                        ChipButton {
                            text: "紧急故障排查";
                            clicked => { root.meeting-topic-input = "线上紧急故障排查与复盘分析"; }
                        }
                    }

                    // 录音开关
                    Rectangle {
                        height: 38px;
                        background: #f8fafc;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.meeting-record-audio ? #6366f1 : #21262d;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.meeting-record-audio = !root.meeting-record-audio; }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "🎙️"; font-size: 14px; vertical-alignment: center; }
                                Text { text: "同步开启麦克风无损录音 (驱动 AI 纪要)"; font-size: 12px; font-weight: 600; color: #0f172a; vertical-alignment: center; }
                            }
                            Text {
                                text: root.meeting-record-audio ? "● 录音开启中" : "○ 已关闭";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.meeting-record-audio ? #3fb950 : #6e7681;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // 底部分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // 3. 底部操作栏 (固定 48px，永远绝不裁切)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "取消";
                        custom-height: 32px;
                        clicked => { root.show-meeting-modal = false; }
                    }
                    PrimaryButton {
                        text: root.meeting-record-audio ? "🎙️ 启动会议计时并录音" : "▶ 启动会议计时";
                        bg-color: #6366f1;
                        hover-color: #4f46e5;
                        custom-height: 32px;
                        clicked => {
                            root.start-quick-meeting(root.meeting-selected-proj-idx, root.meeting-topic-input, root.meeting-rate-input, root.meeting-record-audio);
                        }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 2: 新建项目弹窗 ====================
    if root.show-new-project-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-new-project-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 490px;
            height: 390px;
            background: #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: #e2e8f0;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text { text: "➕ 创建新的商业项目"; font-size: 15px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-new-project-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #e2e8f0 : #f1f5f9;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #64748b;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // Form Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;

                    Text { text: "项目名称 (必填)"; font-size: 11px; color: #64748b; }
                    DarkInput { custom-height: 30px; placeholder: "例如：客户A 跨境商城二次重构"; text <=> root.new-proj-name; }

                    Text { text: "客户/组织名称"; font-size: 11px; color: #64748b; }
                    DarkInput { custom-height: 30px; placeholder: "例如：张总 / 某某科技有限公司"; text <=> root.new-proj-client; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "人天单价 (元/天)"; font-size: 11px; color: #64748b; }
                            DarkInput { custom-height: 30px; placeholder: "3000"; text <=> root.new-proj-rate; }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "货币单位 (币种)"; font-size: 11px; color: #64748b; }
                            DarkInput { custom-height: 30px; placeholder: "CNY"; text <=> root.new-proj-currency; }
                        }
                    }

                    Text { text: "本地 Git 仓库路径 (可选)"; font-size: 11px; color: #64748b; }
                    DarkInput { custom-height: 30px; placeholder: "/path/to/your/git-project"; text <=> root.new-proj-git; }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "取消";
                        custom-height: 32px;
                        clicked => { root.show-new-project-modal = false; }
                    }
                    PrimaryButton {
                        text: "➕ 保存并创建项目";
                        bg-color: #238636;
                        hover-color: #2ea043;
                        custom-height: 32px;
                        clicked => { root.submit-new-project(); }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 3: AFK校准弹窗 ====================
    if root.show-afk-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-afk-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 490px;
            height: 380px;
            background: #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: #e2e8f0;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;
                    Text { text: "⚡ AFK 离开工时校准"; font-size: 15px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-afk-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #e2e8f0 : #f1f5f9;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #64748b;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // Content Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    Text {
                        text: "检测到您离开键盘超过设定阈值。系统已自动保护并发计时通道，请确认是否扣除离开工时：";
                        font-size: 12px;
                        color: #64748b;
                    }

                    ScrollView {
                        height: 150px;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 6px;
                            for a in root.afk-items : Rectangle {
                                height: 42px;
                                background: #f8fafc;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: a.project-name; font-size: 12px; font-weight: 700; color: #0f172a; }
                                        Text { text: "当前累计: " + a.elapsed-text; font-size: 11px; color: #64748b; }
                                    }
                                    Text { text: "建议扣除"; font-size: 11px; color: #d29922; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: end;
                    spacing: 10px;

                    OutlineButton {
                        text: "全部保留有效投入";
                        custom-height: 32px;
                        clicked => { root.apply-afk-resolution(false); }
                    }
                    PrimaryButton {
                        text: "全部扣除离开时间";
                        bg-color: #d29922;
                        hover-color: #bb8009;
                        custom-height: 32px;
                        clicked => { root.apply-afk-resolution(true); }
                    }
                }
            }
        }
    }

    // ==================== 独立居中 Modal 4: 会议纪要与转写文稿详情弹窗 ====================
    if root.show-detail-modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        // 点击遮罩空白关闭弹窗
        TouchArea {
            clicked => { root.show-detail-modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 580px;
            height: 520px;
            background: #ffffff;
            border-radius: 14px;
            border-width: 1px;
            border-color: #e2e8f0;

            // 拦截卡片内部点击
            TouchArea {}

            VerticalLayout {
                // 1. Header (46px)
                HorizontalLayout {
                    height: 46px;
                    padding-left: 18px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: #6366f1;
                            Text {
                                text: "📄";
                                font-size: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "会议纪要与录音凭证详情"; font-size: 15px; font-weight: 800; color: #0f172a; }
                            Text { text: root.detail-project-name + " · " + root.detail-time-range + " (" + root.detail-duration + " · " + root.detail-amount + ")"; font-size: 11px; color: #64748b; }
                        }
                    }

                    TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.show-detail-modal = false; }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: parent.has-hover ? #e2e8f0 : #f1f5f9;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 700;
                                color: #64748b;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // 2. Body
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 10px;

                    // 音频操作横条 (如果有录音)
                    if root.detail-has-audio : Rectangle {
                        height: 38px;
                        background: #f8fafc;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "🎙️ 会议录音"; font-size: 12px; font-weight: 700; color: #c4b5fd; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                MiniButton {
                                    text: root.playing-entry-id == root.detail-entry-id ? "⏹ 停止播放" : "▶ 播放录音";
                                    bg-color: root.playing-entry-id == root.detail-entry-id ? #da3633 : #6366f1;
                                    hover-color: root.playing-entry-id == root.detail-entry-id ? #b62324 : #4f46e5;
                                    clicked => {
                                        if (root.playing-entry-id == root.detail-entry-id) {
                                            root.stop-audio-playback();
                                        } else {
                                            root.play-entry-audio(root.detail-entry-id, root.detail-audio-path);
                                        }
                                    }
                                }
                                OutlineButton {
                                    text: "📂 录音目录";
                                    custom-height: 24px;
                                    clicked => { root.open-entry-folder(root.detail-audio-path); }
                                }
                                MiniButton {
                                    text: "🤖 AI语音转写";
                                    bg-color: #238636;
                                    hover-color: #2ea043;
                                    clicked => { root.transcribe-entry-audio(root.detail-entry-id, root.detail-audio-path); }
                                }
                            }
                        }
                    }

                    // 模块 1: AI 会议纪要与交付提炼
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "✨ AI 会议纪要与交付决策"; font-size: 12px; font-weight: 700; color: #58a6ff; }
                        }
                        Rectangle {
                            height: 140px;
                            background: #f8fafc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.detail-summary;
                                        font-size: 12px;
                                        color: #0f172a;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // 模块 2: 录音转写文稿 (Whisper 逐字稿)
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "📝 录音转写全文文稿 (Whisper Transcript)"; font-size: 12px; font-weight: 700; color: #58a6ff; }
                            if root.detail-transcript != "" : Text {
                                text: "✓ 已完成转写";
                                font-size: 11px;
                                color: #3fb950;
                            }
                        }
                        Rectangle {
                            height: 140px;
                            background: #f8fafc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.detail-transcript != "" ? root.detail-transcript : (root.detail-has-audio ? "尚未转写文稿。点击上方【🤖 AI语音转写】调用 Whisper 提取全文逐字稿。" : "此工时条目无附加麦克风录音。");
                                        font-size: 12px;
                                        color: root.detail-transcript != "" ? #c9d1d9 : #6e7681;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // 分割线
                Rectangle { height: 1px; background: #f1f5f9; }

                // 3. Footer (48px)
                HorizontalLayout {
                    height: 48px;
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;

                    OutlineButton {
                        text: "📋 复制纪要与文稿";
                        custom-height: 32px;
                        clicked => {
                            root.copy-text-to-clipboard(root.detail-summary + "\n\n=== 录音转写文稿 ===\n" + root.detail-transcript);
                        }
                    }

                    PrimaryButton {
                        text: "关闭";
                        bg-color: #21262d;
                        hover-color: #30363d;
                        text-color: #334155;
                        custom-height: 32px;
                        clicked => { root.show-detail-modal = false; }
                    }
                }
            }
        }
    }
}
